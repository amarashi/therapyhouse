---
import { withBase } from '../lib/base.js';
import { getEntry, render } from 'astro:content';
import PlainLayout from '../layouts/PlainLayout.astro';
import HeroReveal from '../components/HeroReveal.astro';

const page = await getEntry('pages', 'philosophy');
if (!page) throw new Error('Missing content: src/content/pages/philosophy.md');

const { Content } = await render(page);
const { title, description, lede, principles, closing } = page.data;
---

<PlainLayout title={title} documentTitle={page.data.documentTitle} description={description}>
  <HeroReveal
    room="philosophy"
    roomName="the attic reading room"
    slot="hero"
    title={title}
    lede={lede}
    image={withBase("/assets/rooms/library-attic-room-out.webp")}
    imageSmall={withBase("/assets/rooms/library-attic-room-out-720.webp")}
    imageMedium={withBase("/assets/rooms/library-attic-room-out-1080.webp")}
    imageMediumWidth={1086}
    imageAlt="The attic reading room — soft light under the eaves"
    imageWidth={1448}
    imageHeight={1086}
  />

  <div class="wrap">
    <div class="prose--flush prose stack">
      <Content />
    </div>

    <section aria-labelledby="principles">
      <div class="section-head"><h2 id="principles">How we work</h2></div>
      <ul class="principles">
        {principles?.map((principle) => (
          <li class="card principle">
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </li>
        ))}
      </ul>
    </section>

    {closing && (
      <div class="prose--flush prose">
        <p class="closing-line">{closing}</p>
      </div>
    )}
  </div>
</PlainLayout>

<style>
  .principles {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2xl);
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
  }

  .principle h3 {
    margin-top: 0;
  }

  .principle p {
    margin-bottom: 0;
  }

  .closing-line {
    font-family: var(--font-display);
    font-size: var(--text-subhead);
    line-height: var(--lh-subhead);
    color: var(--heading);
  }
</style>
