---
import { withBase, stripBase } from '../lib/base.js';
import { readyNav, contact, callsToAction } from '../data/site.js';

/**
 * The site's navigation, in two forms.
 *
 * Below 90rem it is an ordinary bar above the hero. At 90rem and up it is the
 * floating rail in the right margin — and there it is a lift: a shaft drawn in
 * CSS running the full height of the viewport, with a brass car parked at the
 * floor you are on. Hovering a floor calls the car to it; leaving sends it
 * back; taking a link sends it there for real, and the building moves past it.
 * The car can also be taken hold of and pulled up or down the shaft: it follows
 * the pointer, snaps to the floor it is let go nearest, and — if that is not
 * the floor you were already on — travels there like any other trip.
 *
 * The car is the only image in the component. Everything else — shaft, guide
 * rails, lamplight, travel — is CSS off a single custom property, `--floor`,
 * which is an integer index rendered into the markup by the server. That
 * matters: with no JavaScript at all the lift is still parked at the right
 * floor on first paint, because the resting position is a static style and not
 * a measurement.
 *
 * It is never hidden. An earlier version faded the rail out while the hero
 * owned the screen and let it arrive with the content, which cost a keyboard
 * user eight links in the tab order behind an invisible menu and left
 * practitioner profiles — the pages with no hero, whose script exited early —
 * with no navigation at all. Now the hero keeps a margin clear for the lift
 * instead (`--rail-gutter`), the shaft runs the full height of the viewport
 * from the first paint, and nothing about the menu depends on a script having
 * run.
 */
/* Compared against the clean hrefs in the nav data, so the deployment's
   base prefix comes off before any of the matching below. */
const path = stripBase(Astro.url.pathname);
const items = [{ label: 'Home', href: '/' }, ...readyNav];

/* Which floor the car is parked on. An exact match first; failing that, the
   longest nav href the path sits under — so a practitioner profile parks the
   lift at Team rather than at nowhere, and the label it is level with is
   marked to match. A path that matches neither (the 404) parks it at Home and
   marks nothing. */
const exact = items.findIndex((item) => item.href === path);
const section = items.reduce((best, item, i) => {
  if (item.href === '/' || !path.startsWith(item.href)) return best;
  return best === -1 || item.href.length > items[best].href.length ? i : best;
}, -1);
const here = exact !== -1 ? exact : section;
const floor = here === -1 ? 0 : here;
---

<nav
  class="rail"
  aria-label="Main"
  data-lift-rail
  data-floor={floor}
  style={`--floor:${floor}`}
>
  <div class="rail__shaft" aria-hidden="true"></div>

  <div class="rail__deck">
    <div class="rail__lift" aria-hidden="true">
      <span class="rail__lamp"></span>
      <img
        class="rail__car"
        src={withBase("/assets/media/lift-car.webp")}
        alt=""
        width="114"
        height="272"
        {/* Lazy so a phone never pays for it. The lift is `display: none`
            below 90rem, which does not stop the fetch on its own — but an
            image that can never enter the viewport is one a lazy loader never
            asks for. Above 90rem it is on screen from the first paint, so it
            loads immediately. */}
        loading="lazy"
        decoding="async"
        draggable="false"
      />
    </div>

    <ul>
      {items.map((item, i) => {
        const current = path === item.href;
        return (
          <li>
            <a
              href={withBase(item.href)}
              data-floor={i}
              data-astro-prefetch
              data-here={i === here ? '' : undefined}
              aria-current={current ? 'page' : undefined}
            >
              <span class="rail__tick" aria-hidden="true"></span>
              <span class="rail__label">{item.label}</span>
            </a>
          </li>
        );
      })}
      <li class="rail__phone">
        <a href={withBase(callsToAction.call.href)}>
          <span class="rail__tick" aria-hidden="true"></span>
          <span class="rail__label">{contact.phone}</span>
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  /* ---- Default: an ordinary bar above the hero ----
     Present from the first paint on every page, at every width below 90rem.
     Navigation is never something the visitor has to scroll to discover.
     The lift belongs to the rail form only, so below 90rem the shaft and car
     are not rendered at all and the deck steps out of the layout entirely. */
  .rail {
    border-bottom: 1px solid var(--line);
    background: var(--surface-raised);
  }

  .rail__shaft,
  .rail__lift {
    display: none;
  }

  .rail__deck {
    display: contents;
  }

  .rail ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-lg);
    margin: 0;
    padding: var(--space-xs) var(--space-lg);
  }

  .rail a {
    display: flex;
    align-items: center;
    gap: 11px;
    /* Touch target, matching the floor the site's own .btn honours. */
    min-height: 44px;
    text-decoration: none;
  }

  /* The tick grows on a transform, not on width: it extends into the margin
     without moving the label beside it or costing a layout pass. */
  .rail__tick {
    display: none;
    width: 13px;
    height: 1px;
    background: var(--line);
    flex: 0 0 auto;
    transform-origin: left center;
    transition: transform 140ms ease, background-color 140ms ease;
  }

  .rail__label {
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    /* 8.3:1 on the warm-white ground. Warm-black, never a neutral grey. */
    color: var(--ink-soft);
    white-space: nowrap;
  }

  /* `data-called` is the floor a dragged car is currently nearest: the one it
     would stop at if let go now. It reads exactly as a hover, because that is
     what it is — the pointer is over the shaft rather than over the label. */
  .rail a:hover .rail__label,
  .rail a[data-called] .rail__label {
    color: var(--hedge-green);
  }

  /* `data-here` marks the floor the car is parked on: the current page, or —
     on a practitioner profile — the section it belongs to. `aria-current` stays
     exact; the extra weight is what separates the two. */
  .rail a[data-here] .rail__label {
    color: var(--hedge-green);
  }

  .rail a[aria-current='page'] .rail__label {
    font-weight: 800;
  }

  .rail__phone .rail__label {
    /* Digits, not words: the tracking that opens up a set of uppercase
       letters pulls a phone number apart into loose pairs. */
    color: var(--chestnut);
    letter-spacing: 0.06em;
    font-variant-numeric: lining-nums tabular-nums;
  }

  /* ---- Narrow: one row, not three ----
     Wrapped, eight floors take three rows and 145px — on a 390x844 phone that
     is 24% of the first screen spent on navigation, above a house that gets
     29%. Nothing is hidden to fix it: the row scrolls sideways instead of
     downward, so every destination is still present, still in the tab order,
     and still reachable with no script. The last item is cut by the viewport
     rather than by a rule, which is the affordance — there is visibly more
     along that way.

     A disclosure would have cost less height again and it is the obvious
     pattern, but it is the wrong one here: this rail is the only navigation on
     the site, it is deliberately complete without JavaScript, and putting the
     whole of it behind a control a worried parent has to think about first is
     the opposite of what the component is for. */
  @media (max-width: 52rem) {
    .rail ul {
      flex-wrap: nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      /* The masthead's own left edge, so the first floor starts on the line
         the wordmark above it starts on. */
      padding-inline: var(--page-inset);
      scroll-padding-inline: var(--page-inset);
      /* Overlay scrollbars auto-hide on touch; on a narrow desktop window a
         permanent one would draw a grey rule under the menu, which is the one
         cool line on a warm page. The cut-off floor is the affordance. */
      scrollbar-width: none;
    }

    .rail ul::-webkit-scrollbar {
      display: none;
    }

    .rail li {
      scroll-snap-align: start;
    }

    /* "Team" and "Home" set narrower than they are tall — 40px against the 44
       the row already gives them. The box grows around the label rather than
       the label growing, so the row's rhythm is unchanged. */
    .rail a {
      justify-content: center;
      min-width: 44px;
    }
  }

  /* Below the action bar's breakpoint the number is a 48px pill in the thumb
     zone on every page (ActionBar.astro), so carrying it here as well spends a
     floor of a scrolling row to repeat what is already on screen. Between 44
     and 52rem there is no bar, and this stays the only place it is reachable —
     the masthead drops it at 44rem. */
  @media (max-width: 44rem) {
    .rail__phone {
      display: none;
    }
  }

  /* ---- 90rem and up: the lift ----
     Only at this width does the left margin clear the 68rem content column,
     so the rail can stand in it without ever crossing the text. */
  @media (min-width: 90rem) {
    .rail {
      /* One row height drives the whole machine: floor spacing, where the car
         parks, and how far it travels. The car's box is the source art's
         114 x 272 at 0.37 scale, which is the proportion it was drawn at
         against these floors. */
      --rail-row: 54px;
      --shaft-w: 28px;
      --lift-w: 42px;
      --lift-h: 100px;
      --lift-ms: 420ms;
      /* Neither an ease-out nor a bounce: a lift leans into the travel and
         eases off the brake at the end. */
      --lift-ease: cubic-bezier(0.62, 0.03, 0.3, 1);
      --shaft-line: rgba(124, 90, 48, 0.2);
      --shaft-guide: rgba(103, 71, 33, 0.55);

      position: fixed;
      right: clamp(20px, 3.4vw, 56px);
      /* Full height, so the shaft can run the height of the building. The nav
         itself is not a hit target — only the deck inside it is. */
      top: 0;
      bottom: 0;
      z-index: 30;
      display: flex;
      align-items: center;
      pointer-events: none;
      border-bottom: 0;
      background: none;
      /* Text hangs off the shaft on the right, mirroring the left-hand form. */
      text-align: right;
    }

    /* Two hairline pairs for the shaft walls and one for the guide rails the
       car rides, on hard stops so each stays a single pixel at any scale —
       which is the reason the shaft is not an image. The wash between them is
       barely there: it reads as a recess in the wall, not as a panel. */
    .rail__shaft {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      right: 0;
      width: var(--shaft-w);
      background-image: linear-gradient(
          90deg,
          transparent 0 1px,
          var(--shaft-line) 1px 2px,
          transparent 2px 4px,
          var(--shaft-line) 4px 5px,
          transparent 5px 12px,
          var(--shaft-guide) 12px 13px,
          transparent 13px 15px,
          var(--shaft-guide) 15px 16px,
          transparent 16px 23px,
          var(--shaft-line) 23px 24px,
          transparent 24px 26px,
          var(--shaft-line) 26px 27px,
          transparent 27px
        ),
        linear-gradient(
          90deg,
          transparent 0 1px,
          rgba(124, 90, 48, 0.035) 1px 27px,
          transparent 27px
        );
      /* The shaft carries on past the screen rather than stopping at two hard
         ends — and it keeps clear of the masthead at the top. */
      -webkit-mask-image: linear-gradient(
        180deg,
        transparent 0,
        #000 15vh,
        #000 88%,
        transparent 100%
      );
      mask-image: linear-gradient(
        180deg,
        transparent 0,
        #000 15vh,
        #000 88%,
        transparent 100%
      );
    }

    .rail__deck {
      display: block;
      position: relative;
      /* Room for the shaft, plus the gap the ticks reach across. */
      padding-right: calc(var(--shaft-w) + 11px);
      pointer-events: auto;
    }

    .rail ul {
      display: block;
      padding: 0;
    }

    .rail a {
      flex-direction: row-reverse;
      min-height: 0;
      height: var(--rail-row);
    }

    /* The car's whole position is this one line: floor index times row height,
       centred on the row. Changing `--floor` — from the server on load, from
       the script on hover — is the entire travel mechanism. */
    .rail__lift {
      display: block;
      position: absolute;
      top: 0;
      right: calc(var(--shaft-w) / 2);
      width: var(--lift-w);
      height: var(--lift-h);
      transform: translate(
        50%,
        calc(var(--rail-row) * var(--floor) + (var(--rail-row) - var(--lift-h)) / 2)
      );
      transition: transform var(--lift-ms) var(--lift-ease);
      /* The car is a handle as well as an indicator. `touch-action: none` is
         what stops a drag down the shaft from being read as a page scroll. */
      cursor: grab;
      touch-action: none;
      -webkit-user-select: none;
      user-select: none;
    }

    .rail[data-lift='dragging'] .rail__lift {
      cursor: grabbing;
      /* Nothing eases while the car is on the finger — it is the pointer. */
      transition: none;
    }

    .rail__car {
      display: block;
      width: 100%;
      height: 100%;
      /* Warm, never neutral: the car is lit by the same lamp as the house. */
      filter: drop-shadow(0 8px 11px rgba(48, 25, 8, 0.22));
      -webkit-user-drag: none;
      pointer-events: none;
    }

    /* Held, the car hangs a little heavier off its cables. */
    .rail[data-lift='dragging'] .rail__car {
      filter: drop-shadow(0 13px 16px rgba(48, 25, 8, 0.3));
    }

    /* The candle behind the cage. It sits at the window's own height in the
       art, so the light leaves the car where the light is drawn. */
    .rail__lamp {
      position: absolute;
      left: 50%;
      top: 47%;
      width: 200%;
      height: 84%;
      transform: translate(-50%, -50%);
      background: radial-gradient(
        closest-side,
        rgba(255, 242, 173, 0.5),
        rgba(255, 190, 68, 0.14) 58%,
        rgba(255, 190, 68, 0) 100%
      );
      filter: blur(5px);
      opacity: 0.72;
      transition: opacity 300ms ease;
      /* The glow is drawn wider than the car. It must not also be grabbable
         that wide, or it would take pointers meant for the labels beside it. */
      pointer-events: none;
    }

    /* Warmer when it is working, not brighter for its own sake. */
    .rail[data-lift] .rail__lamp {
      opacity: 1;
    }

    .rail[data-lift='arrived'] .rail__car {
      animation: lift-settle 340ms cubic-bezier(0.33, 0.68, 0.36, 1);
    }

    .rail__tick {
      display: block;
    }

    .rail a:hover .rail__tick,
    .rail a[data-called] .rail__tick {
      transform: scaleX(1.54);
      background: var(--hedge-sage);
    }

    .rail a[data-here] .rail__tick {
      transform: scaleX(1.85) scaleY(2);
      background: var(--hedge-green);
    }

    /* The lift carries floors, and the phone was never one — it sat below a
       rule at the bottom of the shaft looking like a destination the car could
       not reach. At these widths the masthead's phone link is on screen at the
       top of the page and ActionBar.astro's floating pair below it, so nothing
       is lost by taking it out of the menu.
       Removed from the lift only: the bar form below 90rem is the one place
       the number is not otherwise reachable, since the masthead drops it on a
       phone. */
    .rail__phone {
      display: none;
    }
  }

  /* A lift settles on its cables when it stops. One and a half pixels of it. */
  @keyframes lift-settle {
    0% {
      transform: translateY(0);
    }
    30% {
      transform: translateY(1.5px);
    }
    62% {
      transform: translateY(-1px);
    }
    100% {
      transform: translateY(0);
    }
  }

  /* The arrival is a motion effect; without it the rail is simply there once
     the content is. The lift keeps its floor — it just stops travelling to it. */
  @media (prefers-reduced-motion: reduce) {
    .rail,
    .rail__tick,
    .rail__lift,
    .rail__lamp {
      transition: none;
    }

    .rail[data-lift='arrived'] .rail__car {
      animation: none;
    }
  }
</style>

<script is:inline>
  /*
   * The lift's behaviour, and nothing else. Every resting state — which floor
   * the car is on, and what it looks like there — is already in the markup and
   * the CSS, so if this never runs the rail is still a complete, correct menu
   * with the car parked at the current floor. This only adds the travel.
   *
   * It moves one custom property, `--floor`. Hover or focus a floor and the car
   * is called to it; leave and it returns to the page you are actually on. Take
   * a link and it goes for real: travel, a moment at the floor, then the
   * building slides past it (`[data-lift-leaving]` in global.css, and the
   * matching arrival in PlainLayout's head).
   *
   * Dragging the car is the same mechanism at a different granularity: while a
   * pointer holds it, `--floor` is a fraction rather than an index and follows
   * the pointer directly, and on release it rounds to a floor and departs. The
   * links remain the whole of the navigation — the car is a second way to reach
   * the same eight, for a pointer, and keyboard use is untouched by it.
   */
  (function () {
    var rail = document.querySelector('[data-lift-rail]');
    if (!rail) return;
    var deck = rail.querySelector('.rail__deck');
    var lift = rail.querySelector('.rail__lift');
    var root = document.documentElement;
    var reduced = matchMedia('(prefers-reduced-motion: reduce)');
    var wide = matchMedia('(min-width: 90rem)');
    var fine = matchMedia('(hover: hover) and (pointer: fine)');

    var home = Number(rail.getAttribute('data-floor')) || 0;
    var at = home;
    var busy = false;
    var drag = null;
    /* The phone row is not a floor, so the top of the shaft is the last link
       that carries one. */
    var topFloor = deck.querySelectorAll('a[data-floor]').length - 1;

    /* Narrow, the row scrolls sideways, and Library or Contact can start off
       the end of it — so the floor you are on is brought into the row. Written
       as a `scrollLeft` rather than `scrollIntoView`, which is allowed to
       scroll every ancestor including the page and would land a visitor part
       way down the hero on arrival. Pure enhancement: without it the menu is
       the same menu, opened at Home. */
    (function () {
      var list = deck.querySelector('ul');
      var current = deck.querySelector('a[data-here]');
      if (!list || !current || list.scrollWidth <= list.clientWidth) return;
      var item = current.parentElement;
      list.scrollLeft = Math.max(
        0,
        item.offsetLeft - (list.clientWidth - item.offsetWidth) / 2
      );
    })();

    /* Below 90rem there is no lift, and under reduced motion it holds its floor
       rather than sliding between them. */
    function live() {
      return wide.matches && !reduced.matches;
    }

    /* Distance costs time, the way it does in a real building: the next floor
       is a hop, top to bottom is a journey. `weight` is what separates a
       tentative hover from a committed trip.

       Re-timed. The distance model is the same one and the choreography is
       unchanged — travel, a moment standing at the floor, then the building
       leaves — but a click on Contact from Home used to hold the page for
       620ms of travel, 190 standing and 180 fading: 990ms between a parent
       asking for the phone number and anything happening, which is past the
       second at which an interface stops feeling like it is answering. The
       trip now runs 380 at its longest and about 610 end to end, and an
       ordinary next-floor hop lands in 440. Still unmistakably a lift; no
       longer something to wait through. */
    function moveTo(target, weight) {
      if (target === at) return 0;
      var ms = Math.round(Math.min(380, 150 + Math.abs(target - at) * 62) * weight);
      rail.style.setProperty('--lift-ms', ms + 'ms');
      rail.style.setProperty('--floor', target);
      at = target;
      return ms;
    }

    function floorFrom(node) {
      var link = node && node.closest ? node.closest('a[data-floor]') : null;
      return link ? Number(link.getAttribute('data-floor')) : null;
    }

    function call(event) {
      if (busy || drag || !live()) return;
      var target = floorFrom(event.target);
      if (target !== null) moveTo(target, 0.8);
    }

    function recall() {
      if (busy || drag || !live()) return;
      moveTo(home, 0.8);
    }

    /* The trip proper, shared by a click on a link and a release of the car:
       travel, a moment standing at the floor, then the building leaves. */
    function depart(link, target) {
      busy = true;
      var dir = target > home ? 1 : -1;
      /* Read once, by the head script on the page being travelled to, so the
         building carries on moving the same way across the load. */
      try {
        sessionStorage.setItem('th-lift', String(dir));
      } catch (err) {}
      root.style.setProperty('--lift-dir', String(dir));

      rail.setAttribute('data-lift', 'travelling');
      var travel = moveTo(target, 1);

      setTimeout(function () {
        rail.setAttribute('data-lift', 'arrived');
        setTimeout(function () {
          root.setAttribute('data-lift-leaving', '');
          /* The link was prefetched on hover, so what follows the fade is
             usually already in the cache and paints straight away. */
          setTimeout(function () {
            location.href = link.href;
          }, 140);
        }, 90);
      }, travel);
    }

    deck.addEventListener('pointerover', function (event) {
      if (fine.matches) call(event);
    });
    deck.addEventListener('pointerleave', function () {
      if (fine.matches) recall();
    });
    deck.addEventListener('focusin', call);
    deck.addEventListener('focusout', function (event) {
      if (!deck.contains(event.relatedTarget)) recall();
    });

    deck.addEventListener('click', function (event) {
      /* Anything the browser would do differently — a new tab, a middle click,
         a download — stays the browser's. The lift takes plain left clicks. */
      if (event.defaultPrevented || event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      var link = event.target.closest ? event.target.closest('a[data-floor]') : null;
      if (!link || busy || !live()) return;

      var target = Number(link.getAttribute('data-floor'));
      if (target === home) return; // already on this floor

      event.preventDefault();
      depart(link, target);
    });

    /* ---- Taking hold of the car ----
       While it is held, `--floor` is a fraction: the car sits wherever the
       pointer has pulled it, between floors as readily as on one. The floor it
       is nearest is marked as though hovered, so what a release would do is
       legible before the release. */

    function floorLink(i) {
      return deck.querySelector('a[data-floor="' + i + '"]');
    }

    /* The floor a release would stop at, shown on the label rather than in the
       shaft — the shaft has no room to say it. */
    function mark(i) {
      var was = deck.querySelector('a[data-called]');
      if (was) was.removeAttribute('data-called');
      var link = i === null ? null : floorLink(i);
      if (link) link.setAttribute('data-called', '');
    }

    function clamp(pos) {
      return Math.max(0, Math.min(topFloor, pos));
    }

    lift.addEventListener('pointerdown', function (event) {
      /* No lift below 90rem, and nothing to take hold of mid-journey. Under
         reduced motion the drag still works: the car is following a pointer,
         which is direct manipulation and not an animation. */
      if (busy || drag || !wide.matches || event.button !== 0) return;
      /* Stops the car being picked up as an image by the browser's own drag. */
      event.preventDefault();

      var row = parseFloat(getComputedStyle(rail).getPropertyValue('--rail-row')) || 54;
      drag = { id: event.pointerId, y: event.clientY, from: at, row: row, moved: false };
      lift.setPointerCapture(event.pointerId);
      rail.setAttribute('data-lift', 'dragging');
      /* Grabbing wins over whatever the pointer is otherwise standing on. */
      root.style.cursor = 'grabbing';
    });

    lift.addEventListener('pointermove', function (event) {
      if (!drag || event.pointerId !== drag.id) return;
      var dy = event.clientY - drag.y;
      /* A press that never really moves stays a press, not a one-pixel trip. */
      if (!drag.moved && Math.abs(dy) < 3) return;
      drag.moved = true;

      var pos = clamp(drag.from + dy / drag.row);
      rail.style.setProperty('--floor', pos);
      at = pos;
      mark(Math.round(pos));
    });

    function release(event) {
      if (!drag || event.pointerId !== drag.id) return;
      var moved = drag.moved;
      drag = null;
      root.style.cursor = '';
      mark(null);
      if (lift.hasPointerCapture(event.pointerId)) {
        lift.releasePointerCapture(event.pointerId);
      }

      /* A press with no travel is not an instruction to go anywhere: the car
         goes back to the floor the site is actually on. */
      var target = moved ? Math.round(clamp(at)) : home;
      var link = floorLink(target);

      /* Let go over the floor the site is already on: nowhere to go, so it
         simply settles onto the nearest row. The state has to leave `dragging`
         before the move, or the rule that pins the car to the pointer would
         hold and it would jump rather than travel. */
      if (target === home || !link) {
        rail.setAttribute('data-lift', 'travelling');
        var settle = moveTo(target, 0.8);
        setTimeout(function () {
          if (busy || drag) return;
          rail.setAttribute('data-lift', 'arrived');
          setTimeout(function () {
            if (!busy && !drag) rail.removeAttribute('data-lift');
          }, 360);
        }, settle);
        return;
      }

      depart(link, target);
    }

    lift.addEventListener('pointerup', release);
    lift.addEventListener('pointercancel', release);
  })();
</script>
