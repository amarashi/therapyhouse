---
/**
 * Fees and Medicare rebates (issue #30, R-60).
 *
 * The fee table that used to sit on /therapy/ lives here now, with
 * everything that changes what a session ends up costing: the Medicare
 * rebate, private health, NDIS, assessments, reports and cancellations.
 *
 * Two sources, kept apart on purpose:
 * - the clinic's own figures and wording, in src/content/pages/fees.md;
 * - Medicare rebate amounts, in src/data/medicare.js, read off MBS Online
 *   with item numbers and an 'as at' date. The build stops when that date
 *   is more than a year old (assertRebatesCurrent).
 */
import { getCollection, getEntry, render } from 'astro:content';
import PlainLayout from '../layouts/PlainLayout.astro';
import IllustratedHead from '../components/IllustratedHead.astro';
import ServiceList from '../components/ServiceList.astro';
import Vignette from '../components/Vignette.astro';
import { withBase } from '../lib/base.js';
import { inlineHtml } from '../lib/inline-text.js';
import { builtPaths } from '../lib/links.js';
import { businessId, serviceLinks } from '../lib/services.js';
import { includeInBuild, isProductionSite, shownItems } from '../lib/drafts.js';
import { contact, site } from '../data/site.js';
import {
  assertRebatesCurrent,
  formatAsAt,
  formatRebate,
  itemUrl,
  medicare,
} from '../data/medicare.js';
import { feeOffers, priceRange } from '../lib/fees.js';

assertRebatesCurrent(medicare);

const production = isProductionSite(Astro.site);
const services = await getCollection('services', (entry) => includeInBuild(entry.data, production));
const built = builtPaths(Object.keys(import.meta.glob('/src/pages/**/*.astro')), services);
const linkIfBuilt = (path: string) => (built.has(path) ? withBase(path) : null);

const page = await getEntry('pages', 'fees');
if (!page) throw new Error('Missing content: src/content/pages/fees.md');
const assessmentsPage = await getEntry('pages', 'assessments');

const { Content } = await render(page);
const {
  title,
  documentTitle,
  description,
  lede,
  sessionLength,
  privateHealth,
  ndis,
  reports,
  cancellation,
  lastReviewed,
  feesText: text,
} = page.data;
if (!text) throw new Error('Missing feesText in src/content/pages/fees.md');
/* Rows switched off ("Show on the live website") stay on the Preview only. */
const fees = shownItems(page.data.fees, production);

const reviewedLabel = lastReviewed
  ? new Intl.DateTimeFormat('en-AU', { month: 'long', year: 'numeric' }).format(lastReviewed)
  : null;

/* Session prices first, then the two other kinds of session, then the
   evening surcharge on its own: it is added to a fee, it is not a fee. */
const feeGroups = [
  { label: null, rows: fees.filter((r) => !r.adjustment && !r.group) },
  { label: text.provisionalHeading, rows: fees.filter((r) => r.group === 'provisional') },
  { label: text.couplesFamilyHeading, rows: fees.filter((r) => r.group === 'couples-family') },
  { label: text.adjustmentsHeading, rows: fees.filter((r) => r.adjustment) },
].filter((g) => g.rows.length > 0);

const asAt = formatAsAt(medicare.asAt);
const checked = formatAsAt(medicare.checked);

const packages = shownItems(assessmentsPage?.data.packages, production).filter((p) => !p.addOn);
const assessmentLinks = serviceLinks(services.filter((e) => e.data.kind === 'assessment'));

const telehealthHref = linkIfBuilt('/telehealth/');
const ndisHref = linkIfBuilt('/ndis/');

const url = new URL(Astro.url.pathname, Astro.site ?? site.origin).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  '@id': businessId(site.origin),
  name: site.name,
  url: site.origin,
  priceRange: priceRange(fees),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Session fees',
    url,
    itemListElement: feeOffers(fees, { confirmed: Boolean(lastReviewed) }),
  },
};
---

<PlainLayout title={title} documentTitle={documentTitle} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <div class="wrap page fees-page">
    <IllustratedHead title={title} lede={lede} art="fees" />

    <div class="prose--flush prose prose--chapters stack">
      <Content />
    </div>

    <section aria-labelledby="session-fees">
      <h2 id="session-fees">{text.sessionFeesHeading}</h2>
      <div class="table-scroll">
        <table class="fee-table">
          <caption>
            {sessionLength}
            {reviewedLabel
              ? ` Fees current as of ${reviewedLabel}.`
              : ` ${text.unconfirmedNote}`}
          </caption>
          <thead>
            <tr>
              <th scope="col">{text.sessionColumn}</th>
              <th scope="col" class="amount">{text.costColumn}</th>
            </tr>
          </thead>
          {feeGroups.map((group) => (
            <tbody class:list={[group.label && 'fee-table__group']}>
              {group.label && (
                <tr>
                  <th scope="rowgroup" colspan="2">{group.label}</th>
                </tr>
              )}
              {group.rows.map((row) => (
                <tr>
                  <th scope="row">
                    {row.label}
                    {row.note && <span class="fee-table__note">{row.note}</span>}
                  </th>
                  <td class="amount">{row.amount}</td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </section>

    <section aria-labelledby="medicare">
      <div class="art-head">
        <Vignette class="art-head__art" name="medicare" sizes="64px" />
        <h2 id="medicare">{text.medicareHeading}</h2>
      </div>
      <div class="prose--flush prose stack">
        <p set:html={inlineHtml(text.medicareIntro)} />
      </div>

      <div class="table-scroll">
        <table class="fee-table rebate-table">
          <caption>
            Rebate per individual session of at least 50 minutes, as at {asAt}. Source:{' '}
            <a href={medicare.source}>{medicare.sourceName}</a>, checked {checked}.
          </caption>
          <thead>
            <tr>
              <th scope="col">Psychologist's registration</th>
              <th scope="col" class="amount">Rebate</th>
              <th scope="col" class="items">MBS items (room, video)</th>
            </tr>
          </thead>
          <tbody>
            {medicare.rebates.map((row) => (
              <tr>
                <th scope="row">
                  {row.label}
                  <span class="fee-table__note">{row.detail}</span>
                </th>
                <td class="amount">{formatRebate(row.rebate)}</td>
                <td class="items">
                  <a href={itemUrl(row.items.inRoom)}>{row.items.inRoom}</a>,{' '}
                  <a href={itemUrl(row.items.video)}>{row.items.video}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="prose--flush prose stack">
        <ul class="tick-list">
          <li>
            Medicare pays a rebate on up to {medicare.sessionsPerYear} individual sessions each
            calendar year (January to December), however many psychologists you see.
          </li>
          {text.medicareNotes.map((note) => <li set:html={inlineHtml(note)} />)}
        </ul>
        <p>
          The amounts are set by the government and change each July. The item numbers in the
          table link to each item on <a href={medicare.source}>MBS Online</a>, the government's
          official list of Medicare items, if you want to check them yourself.
        </p>
      </div>
    </section>

    <section aria-labelledby="referral">
      <h2 id="referral">{text.referralHeading}</h2>
      {/* The GP's bag beside the steps that start with the GP. */}
      <div class="referral">
      <ol class="step-list">
        {text.referralSteps.map((step) => <li set:html={inlineHtml(step)} />)}
      </ol>
      <Vignette class="referral__art" name="gp" sizes="200px" />
      </div>
      <p class="fees-page__source">
        Referral rules from the <a href={medicare.rulesSource}>Better Access explanatory note</a>{' '}
        on MBS Online.
      </p>
    </section>

    {/* Three other things that change what a session costs, side by side:
        each a short answer, each with its own object on top. */}
    <div class="ways">
    <section class="way" aria-labelledby="video">
      <Vignette class="way__art" name="video" sizes="120px" />
      <h2 id="video">{text.videoHeading}</h2>
      <div class="prose--flush prose stack">
        <p set:html={inlineHtml(text.videoText)} />
        {telehealthHref && (
          <p>
            <a class="standalone-link" href={telehealthHref}>{text.videoLinkText}</a>
          </p>
        )}
      </div>
    </section>

    <section class="way" aria-labelledby="private-health">
      <Vignette class="way__art" name="private-health" sizes="120px" />
      <h2 id="private-health">{text.privateHealthHeading}</h2>
      <ul class="tick-list">
        {privateHealth?.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="way" aria-labelledby="ndis">
      <Vignette class="way__art" name="ndis" sizes="120px" />
      <h2 id="ndis">{text.ndisHeading}</h2>
      <ul class="tick-list">
        {ndis?.map((item) => <li>{item}</li>)}
      </ul>
      {ndisHref && (
        <p><a class="standalone-link" href={ndisHref}>{text.ndisLinkText}</a></p>
      )}
    </section>
    </div>

    <section aria-labelledby="assessments">
      <div class="art-head">
        <Vignette class="art-head__art" name="assess-intro" sizes="64px" />
        <h2 id="assessments">{text.assessmentsHeading}</h2>
      </div>
      <div class="prose--flush prose stack">
        <p set:html={inlineHtml(text.assessmentsIntro)} />
        <ul class="tick-list">
          {packages.map((pkg) => (
            <li>
              {pkg.title}: {pkg.price}
              {pkg.provisionalPrice && `, or ${pkg.provisionalPrice} with a provisional psychologist`}
            </li>
          ))}
        </ul>
        <p>
          Medicare has separate items for assessing a suspected complex neurodevelopmental
          condition, such as autism, in a person under {medicare.neurodevelopmental.maxAge} who
          has been referred by a paediatrician or psychiatrist (MBS item{' '}
          <a href={itemUrl(medicare.neurodevelopmental.item)}>{medicare.neurodevelopmental.item}</a>).
          Ask reception before you book whether any part of your assessment can be claimed.
        </p>
        <p>
          <a class="standalone-link" href={withBase('/assessments/')}>{text.assessmentsLinkText}</a>
        </p>
      </div>
      {/* The assessment pages as the same tiles /assessments/ shows. */}
      {assessmentLinks.length > 0 && (
        <div class="fees-page__tiles">
          <ServiceList links={assessmentLinks} />
        </div>
      )}
    </section>

    <section aria-labelledby="reports">
      <div class="art-head">
        <Vignette class="art-head__art" name="letters" sizes="64px" />
        <h2 id="reports">{text.reportsHeading}</h2>
      </div>
      <div class="prose--flush prose stack">
        {reports?.map((item) => <p>{item}</p>)}
      </div>
    </section>

    {cancellation && (
      <section aria-labelledby="cancellation">
        <div class="art-head">
          <Vignette class="art-head__art" name="cancellations" sizes="64px" />
          <h2 id="cancellation">{text.cancellationHeading}</h2>
        </div>
        <p>
          This is the cancellation policy the clinic published in {cancellation.published}. The
          fee for cancelling depends on how much notice you give:
        </p>
        <ul class="tick-list">
          {cancellation.rules.map((rule) => <li>{rule}</li>)}
        </ul>
        <div class="prose--flush prose stack">
          {cancellation.notes.map((note) => <p>{note}</p>)}
          <p>
            Business days are Monday to Friday, not counting public holidays. To cancel or change
            an appointment, email <a href={`mailto:${contact.email}`}>{contact.email}</a>.
          </p>
        </div>
      </section>
    )}

    <section aria-labelledby="questions">
      <h2 id="questions">{text.questionsHeading}</h2>
      <p set:html={inlineHtml(text.questionsText)} />
    </section>
  </div>
</PlainLayout>

<style>
  .page > * + * {
    margin-top: var(--space-section);
  }

  .page h2 {
    margin-top: 0;
  }

  .fee-table {
    max-width: 46rem;
  }

  .fees-page caption {
    max-width: 42rem;
  }

  .table-scroll + .prose,
  .prose + .table-scroll,
  .step-list + .fees-page__source,
  .tick-list + .prose,
  .tick-list + p {
    margin-top: var(--space-xl);
  }

  .rebate-table .items {
    text-align: right;
    white-space: nowrap;
    font-size: var(--text-secondary);
  }

  .fees-page__source {
    font-size: var(--text-secondary);
  }

  .fees-page__tiles {
    margin-top: var(--space-xl);
  }

  /* ---- The GP referral ---- */

  .referral {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .referral .step-list {
    margin-bottom: 0;
    max-width: var(--content-max);
  }

  .referral :global(.referral__art) {
    display: block;
    width: min(170px, 50%);
    height: auto;
  }

  @media (min-width: 60rem) {
    .referral {
      grid-template-columns: minmax(0, var(--content-max)) 200px;
      column-gap: var(--space-3xl);
    }

    .referral :global(.referral__art) {
      width: 100%;
    }
  }

  /* ---- Video, private health, NDIS ---- */

  .ways {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    align-items: start;
  }

  .way {
    padding: var(--space-lg) var(--space-xl) var(--space-xl);
    background: var(--surface-sunk);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-lg);
    box-shadow: var(--edge-lit);
  }

  .way :global(.way__art) {
    display: block;
    width: 110px;
    height: auto;
    margin-bottom: var(--space-sm);
    filter: drop-shadow(0 8px 10px rgba(48, 25, 8, 0.14));
  }

  .way h2 {
    font-size: var(--text-subhead);
    line-height: var(--lh-subhead);
  }

  .way .tick-list,
  .way .prose > :last-child,
  .way > :last-child {
    margin-bottom: 0;
  }

  @media (max-width: 52rem) {
    .fee-table .amount {
      font-size: var(--text-cardtitle);
    }

    .fee-table th[scope='row'] {
      padding-right: var(--space-md);
    }
  }
</style>
