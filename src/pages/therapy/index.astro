---
/**
 * The Therapy floor: the hub every therapy page hangs off.
 *
 * It was /services/, and /services/ now forwards here (astro.config.mjs). The
 * lift has six floors and no drop-downs, so this page is how a visitor — and a
 * search engine — reaches each therapy page: one plain link per page, under
 * the heading of who it is for, generated from `src/content/services/` so a
 * new page is listed the moment its Markdown file exists.
 *
 * The fee table moved to /fees/ (issue #30), with the Medicare rebates and
 * everything else that changes what a session costs. This page keeps a short
 * pointer where the table used to be, so a visitor who came here for prices
 * is one link away from them.
 */
import { withBase } from '../../lib/base.js';
import { getCollection, getEntry, render } from 'astro:content';
import PlainLayout from '../../layouts/PlainLayout.astro';
import HeroReveal from '../../components/HeroReveal.astro';
import ServiceList from '../../components/ServiceList.astro';
import { hubGroups, hubLinks, includeInBuild, isProductionSite } from '../../lib/services.js';

const production = isProductionSite(Astro.site);
const built = await getCollection('services', (entry) => includeInBuild(entry.data, production));
const groups = hubGroups(built);
/* The audience hubs (/adults/, /children/) gather therapy and assessments for
   one age group; linked here for the visitor who starts from who, not what. */
const audienceHubs = hubLinks(built);

const page = await getEntry('pages', 'services');
if (!page) throw new Error('Missing content: src/content/pages/services.md');

const { Content } = await render(page);
const { title, documentTitle, description, lede, offerings, therapyModels } = page.data;
---

<PlainLayout title={title} documentTitle={documentTitle} description={description}>
  <HeroReveal
    room="services"
    roomName="the consulting room"
    slot="hero"
    title={title}
    lede={lede}
    image={withBase("/assets/rooms/consulting-room-out.webp")}
    imageSmall={withBase("/assets/rooms/consulting-room-out-720.webp")}
    imageMedium={withBase("/assets/rooms/consulting-room-out-1080.webp")}
    imageMediumWidth={1086}
    imageAlt="The consulting room — armchairs, lamplight and a window onto the garden"
    imageWidth={1448}
    imageHeight={1086}
  />

  <div class="wrap page">
    <div class="prose--flush prose stack">
      <Content />
    </div>

    {audienceHubs.length > 0 && (
      <section class="hub" aria-labelledby="by-age">
        <h2 id="by-age">Start from who the help is for</h2>
        <ServiceList links={audienceHubs} />
      </section>
    )}

    {groups.length > 0 && (
      <section class="hub" aria-labelledby="therapy-pages">
        <h2 id="therapy-pages">Find the right kind of help</h2>
        {groups.map((group) => (
          <section class="hub__group" aria-labelledby={`hub-${group.key}`}>
            <h3 id={`hub-${group.key}`}>{group.label}</h3>
            <ServiceList links={group.links} />
          </section>
        ))}
      </section>
    )}

    {/*
      What the clinic does, in one band: the list a visitor scans for their own
      situation, and the methods behind it beside rather than under. Stacked,
      they were two identically-set bullet lists a screen apart with nothing to
      tell a parent which one was for them.
    */}
    <div class="band">
      <section aria-labelledby="offerings">
        <h2 id="offerings">What we help with</h2>
        <ul class="tick-list">
          {offerings?.map((item) => <li>{item}</li>)}
        </ul>
        <p class="band__aside-note">
          Assessments have their own process, timeline and pricing —
          <a href={withBase("/assessments/")}>see the assessment packages</a>.
        </p>
      </section>

      <section class="band__side" aria-labelledby="models">
        <h2 id="models">Therapy models</h2>
        <ul class="tick-list band__side-list">
          {therapyModels?.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </div>

    <section class="fees-pointer" aria-labelledby="fees">
      <h2 id="fees">Fees and Medicare</h2>
      <p>
        Session fees, Medicare rebates with a GP referral, private health, NDIS and
        cancellations are all on one page.
      </p>
      <p>
        <a class="standalone-link" href={withBase('/fees/')}>Fees and Medicare rebates</a>
      </p>
    </section>

    <section class="fees-pointer" aria-labelledby="video">
      <h2 id="video">Sessions by video</h2>
      <p>
        If you live outside Brisbane, or the trip to The Gap is hard, you can see a
        psychologist by video from anywhere in Australia.
      </p>
      <p>
        <a class="standalone-link" href={withBase('/telehealth/')}>How video sessions work</a>
      </p>
    </section>
  </div>
</PlainLayout>

<style>
  /* Three questions on one page: what you can come here for, how the work is
     done, what it costs. The break between two questions is the page's largest
     interval; inside one, the heading's own margin is the whole gap. Every
     section used to open on the same 64px, which gave three headings identical
     weight and the page no cadence. */
  .page > * + * {
    margin-top: var(--space-section);
  }

  .page h2 {
    margin-top: 0;
  }

  /* ---- The hub ----
     Each heading sits a section-sized step below the last, but a heading and
     its own list stay together: the list is the answer to the heading. */
  .hub__group + .hub__group {
    margin-top: var(--space-2xl);
  }

  .hub__group h3 {
    margin-top: var(--space-xl);
  }

  /* ---- The two-column band ----
     What the clinic helps with, beside the methods behind it. */
  .band {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .band {
      grid-template-columns: minmax(0, var(--content-max)) minmax(15rem, 1fr);
      column-gap: clamp(var(--space-2xl), 4.5vw, 5rem);
    }

    /* "What we help with" is set at h2 and "How we work" a step below it, which
       is the hierarchy this band is for. Aligned on the tops of their boxes,
       though, two different sizes start on two different lines and the
       deliberate step reads as a misalignment — seven pixels of it, which is
       exactly the amount that looks like a mistake rather than a decision.
       Baseline alignment puts both headings on one line and lets the size
       difference be the only thing saying which one leads. */
    .band {
      align-items: baseline;
    }
  }

  /* Supporting, and sized to say so. The methods are what
     a visitor reads after they have found their own situation in the column
     beside them, not before. */
  .band__side h2 {
    font-size: var(--text-subhead);
    line-height: var(--lh-subhead);
  }

  .band__side-list {
    margin-bottom: 0;
  }

  .band__aside-note {
    margin-bottom: 0;
  }

  /* ---- Fees pointer ---- */
  .fees-pointer {
    max-width: var(--content-max);
  }

  .fees-pointer p:last-child {
    margin-bottom: 0;
  }
</style>
