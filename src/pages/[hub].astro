---
/**
 * The audience hubs: /adults/ and /children/ (issues #5, #6).
 *
 * They live at the site root because that is the address a person types and a
 * search result shows ("psychologist for adults", "child psychologist"), and
 * because a hub belongs to neither /therapy/ nor /assessments/: it links into
 * both. Each hub is a Markdown file in `src/content/services/` with
 * `kind: hub`; ServicePage lists every page that shares its audience.
 */
import { getCollection } from 'astro:content';
import ServicePage from '../layouts/ServicePage.astro';
import { includeInBuild, isProductionSite } from '../lib/services.js';

export async function getStaticPaths() {
  const production = isProductionSite(import.meta.env.SITE);
  const entries = await getCollection(
    'services',
    (entry) => entry.data.kind === 'hub' && includeInBuild(entry.data, production)
  );
  return entries.map((entry) => ({ params: { hub: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<ServicePage entry={entry} />
