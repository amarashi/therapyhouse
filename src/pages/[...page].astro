---
/**
 * Service pages that do not live under /therapy/ or /assessments/.
 *
 * - The audience hubs, /adults/ and /children/ (issues #5, #6), at the site
 *   root because that is the address a person types and a search result shows,
 *   and because a hub belongs to neither /therapy/ nor /assessments/.
 * - Any entry with its own `path`: /ndis/ (issue #13), and the Circle of
 *   Security page, which keeps its Current Site address under /group-therapy/
 *   (issue #14).
 *
 * Each is a Markdown file in `src/content/services/`; ServicePage does the
 * work. A rest parameter, so a path with more than one segment can be built.
 * Static routes (`group-therapy.astro`, `fees.astro`) still win over this one.
 */
import { getCollection } from 'astro:content';
import ServicePage from '../layouts/ServicePage.astro';
import { builtAtOwnPath, includeInBuild, isProductionSite, servicePath } from '../lib/services.js';

export async function getStaticPaths() {
  const production = isProductionSite(import.meta.env.SITE);
  const entries = await getCollection(
    'services',
    (entry) => builtAtOwnPath(entry.data) && includeInBuild(entry.data, production)
  );
  return entries.map((entry) => ({
    params: { page: servicePath(entry.data.kind, entry.id, entry.data.path).replace(/^\/|\/$/g, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<ServicePage entry={entry} />
