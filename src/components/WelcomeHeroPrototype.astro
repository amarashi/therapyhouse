---
/*
 * PROTOTYPE — THROWAWAY. Delete this file and the two lines that render it in
 * `src/pages/index.astro` once a direction is picked.
 *
 * Question it answers: "how should the welcome message in the homepage hero
 * behave?" Five treatments of the same welcome, switchable via `?variant=` and
 * the floating bar at the bottom of the screen, layered over the real hero on
 * the real homepage — same artwork, same masthead, same lift, same scroll.
 *
 *   now — untouched. The hero exactly as it ships today, for comparison.
 *   A   — Set like a storybook.  Typeset hierarchy (small sage greeting over a
 *         large green name) + a written-line entrance + a scroll that recedes
 *         in depth with the house instead of fading flat.
 *   B   — Lamplight on the words.  A adds a warm lamp that drifts across the
 *         letterforms and follows the pointer, warming the ink as it passes.
 *   C   — Walk in.  A, but the scroll is cinema: the words grow and part and
 *         pass the camera while the house withdraws through the gap.
 *   D   — Fireflies from the house.  A plus gold motes drifting out of the
 *         illustration toward the welcome, parting around the cursor.
 *
 * A is the shared base — B, C and D are all "A plus one signature move", which
 * is what makes them comparable. Nothing here touches HeroReveal.astro: the
 * script below re-writes the existing <h1> in place before first paint.
 *
 * Everything is gated on `import.meta.env.DEV`, so a stray merge ships nothing.
 */
---

{import.meta.env.DEV && (
  <>
    <div class="wp-bar" data-wp-bar aria-label="Hero welcome prototype">
      <button class="wp-bar__step" type="button" data-wp-prev aria-label="Previous variant">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 3 5 8l5 5" />
        </svg>
      </button>
      <span class="wp-bar__label">
        <span class="wp-bar__key" data-wp-key>A</span>
        <span class="wp-bar__name" data-wp-name>Set like a storybook</span>
      </span>
      <button class="wp-bar__step" type="button" data-wp-next aria-label="Next variant">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 3 5 5-5 5" />
        </svg>
      </button>
      <button class="wp-bar__step wp-bar__replay" type="button" data-wp-replay aria-label="Replay the entrance">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M13.5 8a5.5 5.5 0 1 1-1.7-3.97" />
          <path d="M13.2 1.9v2.9h-2.9" />
        </svg>
      </button>
    </div>

    <script is:inline>
      /*
       * Runs during parse, immediately after the hero markup, so the welcome is
       * already split and already in its pre-entrance state before first paint.
       */
      (function () {
        var root = document.documentElement;
        var KEYS = ['now', 'A', 'B', 'C', 'D'];
        var NAMES = {
          now: 'As it ships today',
          A: 'Set like a storybook',
          B: 'Lamplight on the words',
          C: 'Walk in',
          D: 'Fireflies from the house',
        };

        var reduced = matchMedia('(prefers-reduced-motion: reduce)');
        var h1 = document.querySelector('.hero__copy h1');
        if (!h1) return;
        var stage = document.querySelector('.hero__stage');

        /* ---- Split the welcome into groups and words ---------------------
           "Welcome to Therapy House" -> a greeting group and a name group,
           every word its own line box so it can rise out of a mask. The text
           itself is untouched, so the accessible name is unchanged. */
        var words = (h1.textContent || '').trim().split(/\s+/);
        if (words.length < 3) return;
        var split = 2; // "Welcome to" | "Therapy House"

        function group(cls, list, from) {
          var g = document.createElement('span');
          g.className = 'ph ' + cls;
          list.forEach(function (word, i) {
            if (i) g.appendChild(document.createTextNode(' '));
            var outer = document.createElement('span');
            outer.className = 'ph-word';
            outer.style.setProperty('--i', from + i);
            var inner = document.createElement('span');
            inner.className = 'ph-word__in';
            inner.textContent = word;
            outer.appendChild(inner);
            g.appendChild(outer);
          });
          return g;
        }

        var wrap = document.createElement('span');
        wrap.className = 'ph-words';
        wrap.appendChild(group('ph--greet', words.slice(0, split), 0));
        wrap.appendChild(document.createTextNode(' '));
        wrap.appendChild(group('ph--name', words.slice(split), split));
        h1.textContent = '';
        h1.appendChild(wrap);

        /* ---- B: the lit duplicate ----------------------------------------
           The same letterforms in warmed ink, laid exactly over the green and
           revealed only where the lamp falls. */
        var lit = wrap.cloneNode(true);
        lit.className = 'ph-words ph-words--lit';
        lit.setAttribute('aria-hidden', 'true');
        h1.appendChild(lit);

        /* ---- D: the motes ------------------------------------------------ */
        var canvas = null;
        var mote = { raf: 0, seen: true, list: [], px: -9999, py: -9999 };

        function ensureCanvas() {
          if (canvas || !stage || reduced.matches) return canvas;
          canvas = document.createElement('canvas');
          canvas.className = 'ph-motes';
          canvas.setAttribute('aria-hidden', 'true');
          stage.appendChild(canvas);
          return canvas;
        }

        function sizeCanvas() {
          if (!canvas) return;
          var r = stage.getBoundingClientRect();
          var dpr = Math.min(2, window.devicePixelRatio || 1);
          canvas.width = Math.round(r.width * dpr);
          canvas.height = Math.round(r.height * dpr);
          canvas.style.width = r.width + 'px';
          canvas.style.height = r.height + 'px';
          var ctx = canvas.getContext('2d');
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          if (!mote.list.length) {
            for (var i = 0; i < 30; i++) {
              mote.list.push({
                // Biased to the right — they come out of the house.
                x: r.width * (0.25 + Math.random() * 0.75),
                y: r.height * (0.12 + Math.random() * 0.78),
                r: 1.4 + Math.random() * 1.9,
                sp: 0.14 + Math.random() * 0.36,
                ph: Math.random() * Math.PI * 2,
                am: 7 + Math.random() * 18,
                a: 0.62 + Math.random() * 0.38,
                tw: 0.4 + Math.random() * 0.9,
                ox: 0,
                oy: 0,
              });
            }
          }
        }

        function drawMotes(t) {
          mote.raf = 0;
          if (!canvas) return;
          var w = parseFloat(canvas.style.width);
          var h = parseFloat(canvas.style.height);
          var ctx = canvas.getContext('2d');
          ctx.clearRect(0, 0, w, h);
          for (var i = 0; i < mote.list.length; i++) {
            var m = mote.list[i];
            // Right to left: out of the house, toward the welcome.
            m.x -= m.sp;
            if (m.x < -12) {
              m.x = w + 12;
              m.y = Math.random() * h;
            }
            var y = m.y + Math.sin(t / 1600 + m.ph) * m.am;

            // Part around the cursor, then drift back.
            var dx = m.x + m.ox - mote.px;
            var dy = y + m.oy - mote.py;
            var d2 = dx * dx + dy * dy;
            if (d2 < 12100) {
              var d = Math.max(18, Math.sqrt(d2));
              var push = (110 - d) / 110;
              m.ox += (dx / d) * push * 2.6;
              m.oy += (dy / d) * push * 2.6;
            }
            m.ox *= 0.94;
            m.oy *= 0.94;

            var px = m.x + m.ox;
            var py = y + m.oy;
            // Brightest crossing the open ground between the house and the
            // welcome; spent by the time they reach the far edge.
            var travel = Math.min(1, Math.max(0, px / w));
            var a = m.a * (0.25 + 0.75 * Math.sin(travel * Math.PI)) * (0.72 + 0.28 * Math.sin(t / 900 * m.tw + m.ph));
            var rad = m.r * 5;
            var g = ctx.createRadialGradient(px, py, 0, px, py, rad);
            g.addColorStop(0, 'rgba(255, 233, 158, ' + a + ')');
            g.addColorStop(0.32, 'rgba(255, 206, 96, ' + a * 0.5 + ')');
            g.addColorStop(1, 'rgba(255, 200, 84, 0)');
            ctx.fillStyle = g;
            ctx.beginPath();
            ctx.arc(px, py, rad, 0, Math.PI * 2);
            ctx.fill();
          }
          if (root.dataset.wp === 'D' && mote.seen) mote.raf = requestAnimationFrame(drawMotes);
        }

        /* ---- B: the lamp -------------------------------------------------
           A rAF lerp toward either the pointer or a slow drift path, so the
           light has weight — it follows, it does not snap. */
        var lamp = { raf: 0, x: 0.32, y: 0.34, tx: 0.32, ty: 0.34, live: false, t: 0 };

        function stepLamp(t) {
          lamp.raf = 0;
          if (!lamp.live) {
            // Lissajous drift: never repeats on a beat you can count.
            lamp.tx = 0.5 + Math.sin(t / 5200) * 0.42;
            lamp.ty = 0.42 + Math.sin(t / 3100 + 1.2) * 0.3;
          }
          lamp.x += (lamp.tx - lamp.x) * 0.055;
          lamp.y += (lamp.ty - lamp.y) * 0.055;
          h1.style.setProperty('--ph-lx', (lamp.x * 100).toFixed(2) + '%');
          h1.style.setProperty('--ph-ly', (lamp.y * 100).toFixed(2) + '%');
          h1.style.setProperty('--ph-nx', lamp.x.toFixed(3));
          h1.style.setProperty('--ph-ny', lamp.y.toFixed(3));
          if (root.dataset.wp === 'B') lamp.raf = requestAnimationFrame(stepLamp);
        }

        function onPointer(event) {
          var key = root.dataset.wp;
          if (key === 'B') {
            var r = h1.getBoundingClientRect();
            lamp.live = true;
            lamp.tx = (event.clientX - r.left) / r.width;
            lamp.ty = (event.clientY - r.top) / r.height;
          }
          if (key === 'D' && canvas) {
            var c = canvas.getBoundingClientRect();
            mote.px = event.clientX - c.left;
            mote.py = event.clientY - c.top;
          }
        }

        function onLeave() {
          lamp.live = false;
          mote.px = -9999;
          mote.py = -9999;
        }

        /* ---- Apply -------------------------------------------------------- */
        function apply(key, replay) {
          root.dataset.wp = key;
          if (key === 'now') root.removeAttribute('data-wp-on');
          else root.setAttribute('data-wp-on', '');

          if (replay && key !== 'now') {
            root.removeAttribute('data-wp-on');
            void h1.offsetWidth;
            root.setAttribute('data-wp-on', '');
          }

          if (key === 'B' && !lamp.raf && !reduced.matches) lamp.raf = requestAnimationFrame(stepLamp);
          if (key === 'D' && !reduced.matches) {
            ensureCanvas();
            sizeCanvas();
            if (!mote.raf) mote.raf = requestAnimationFrame(drawMotes);
          }

          var bar = document.querySelector('[data-wp-bar]');
          if (bar) {
            bar.querySelector('[data-wp-key]').textContent = key;
            bar.querySelector('[data-wp-name]').textContent = NAMES[key];
          }
          try {
            var url = new URL(location.href);
            url.searchParams.set('variant', key);
            history.replaceState(null, '', url);
          } catch (err) {}
        }

        /* The shipping hero is the default, and the prototype is opt-in. This
           fell back to 'A', so every `pnpm dev` — and therefore every review,
           screenshot and "does this feel right" conversation held at that URL
           — was about a throwaway rather than about the product. `pnpm
           prototype` passes `?variant=A` explicitly and is unaffected. */
        var start = new URLSearchParams(location.search).get('variant');
        apply(KEYS.indexOf(start) > -1 ? start : 'now', false);

        addEventListener('pointermove', onPointer, { passive: true });
        addEventListener('pointerleave', onLeave, { passive: true });
        addEventListener('resize', function () { if (canvas) sizeCanvas(); }, { passive: true });

        if ('IntersectionObserver' in window && stage) {
          new IntersectionObserver(function (entries) {
            mote.seen = entries[0].isIntersecting;
            if (mote.seen && root.dataset.wp === 'D' && !mote.raf) mote.raf = requestAnimationFrame(drawMotes);
          }).observe(stage);
        }

        function cycle(step) {
          var i = KEYS.indexOf(root.dataset.wp);
          apply(KEYS[(i + step + KEYS.length) % KEYS.length], true);
        }

        addEventListener('DOMContentLoaded', function () {
          var bar = document.querySelector('[data-wp-bar]');
          if (!bar) return;
          bar.querySelector('[data-wp-prev]').addEventListener('click', function () { cycle(-1); });
          bar.querySelector('[data-wp-next]').addEventListener('click', function () { cycle(1); });
          bar.querySelector('[data-wp-replay]').addEventListener('click', function () {
            scrollTo({ top: 0, behavior: 'instant' });
            apply(root.dataset.wp, true);
          });
          apply(root.dataset.wp, false);
        });

        addEventListener('keydown', function (event) {
          var el = document.activeElement;
          if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable)) return;
          if (event.key === 'ArrowLeft') cycle(-1);
          else if (event.key === 'ArrowRight') cycle(1);
        });
      })();
    </script>

    <style is:global>
      /* ============================================================
         PROTOTYPE STYLES — throwaway, deleted with the component.
         Everything hangs off `html[data-wp="…"]`, so `now` is the real
         hero with nothing added.
         ============================================================ */

      /* ---- Shared base (A, and therefore B, C and D) ------------------- */

      html[data-wp-on] .hero.hero--anchored h1 {
        max-width: 15ch;
        text-wrap: balance;
      }

      html[data-wp-on] .ph-words {
        display: block;
      }

      html[data-wp-on] .ph {
        display: block;
      }

      /* The greeting is the small part. It was competing with the name at the
         same size across three ragged lines; here it introduces it. */
      html[data-wp-on] .ph--greet {
        font-size: 0.4em;
        line-height: 1.12;
        letter-spacing: 0.005em;
        color: var(--heading-accent);
        margin-bottom: 0.1em;
      }

      /* A line box per word, so a word can rise out of one. The padding and
         its matching negative margin give Georgia's descenders somewhere to
         live inside an `overflow: hidden` box. */
      html[data-wp-on] .ph-word {
        display: inline-block;
        overflow: hidden;
        padding-bottom: 0.2em;
        margin-bottom: -0.2em;
        vertical-align: bottom;
      }

      html[data-wp-on] .ph-word__in {
        display: inline-block;
      }

      @media (prefers-reduced-motion: no-preference) {
        html[data-wp-on] .ph-word__in {
          animation: ph-rise 900ms cubic-bezier(0.16, 0.86, 0.24, 1) both;
          animation-delay: calc(var(--i, 0) * 78ms + 90ms);
        }

        html[data-wp-on] .hero h1::after {
          transform-origin: left center;
          animation: ph-rule 760ms cubic-bezier(0.16, 0.86, 0.24, 1) 420ms both;
        }

        html[data-wp-on] .hero .lede {
          animation: ph-lede 800ms cubic-bezier(0.16, 0.86, 0.24, 1) 560ms both;
        }
      }

      @keyframes ph-rise {
        from {
          transform: translateY(0.66em) rotate(1.1deg);
          filter: blur(7px);
          opacity: 0;
        }
        55% {
          filter: blur(0);
        }
        to {
          transform: none;
          filter: blur(0);
          opacity: 1;
        }
      }

      @keyframes ph-rule {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }

      @keyframes ph-lede {
        from {
          transform: translateY(14px);
          opacity: 0;
        }
        to {
          transform: none;
          opacity: 1;
        }
      }

      /* ---- A: the scroll recedes in depth with the house ---------------- */
      html[data-wp="A"] .hero.hero--anchored .hero__copy,
      html[data-wp="B"] .hero.hero--anchored .hero__copy,
      html[data-wp="D"] .hero.hero--anchored .hero__copy {
        transform-origin: left center;
        opacity: clamp(0, calc((0.7 - var(--p, 0)) / 0.42), 1);
        transform: translateY(calc(var(--p, 0) * -72px)) scale(calc(1 - var(--p, 0) * 0.17));
      }

      /* ---- B: lamplight ------------------------------------------------- */
      html[data-wp="B"] .hero__copy h1 {
        position: relative;
        --ph-lx: 32%;
        --ph-ly: 34%;
        --ph-nx: 0.32;
        --ph-ny: 0.34;
      }

      html[data-wp] .ph-words--lit {
        display: none;
      }

      html[data-wp="B"] .ph-words--lit {
        display: block;
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        color: var(--chestnut);
        pointer-events: none;
        -webkit-mask-image: radial-gradient(
          circle 300px at var(--ph-lx) var(--ph-ly),
          #000 0%,
          rgba(0, 0, 0, 0.86) 26%,
          rgba(0, 0, 0, 0) 64%
        );
        mask-image: radial-gradient(
          circle 300px at var(--ph-lx) var(--ph-ly),
          #000 0%,
          rgba(0, 0, 0, 0.86) 26%,
          rgba(0, 0, 0, 0) 64%
        );
      }

      /* The shadow leans away from wherever the light is standing. */
      html[data-wp="B"] .ph-words--lit .ph-word__in {
        text-shadow: calc((0.5 - var(--ph-nx, 0.5)) * 16px)
          calc((0.5 - var(--ph-ny, 0.5)) * 12px) 20px rgba(60, 35, 12, 0.26);
      }

      html[data-wp="B"] .ph-words--lit .ph--greet {
        color: #a9713f;
      }

      /* ---- C: walk in --------------------------------------------------- */
      @media (prefers-reduced-motion: no-preference) {
        html[data-wp="C"] .hero.hero--anchored .hero__copy {
          transform-origin: 20% center;
          opacity: clamp(0, calc((0.74 - var(--p, 0)) / 0.3), 1);
          transform: translate3d(calc(var(--p, 0) * -13vw), calc(var(--p, 0) * -5vh), 0)
            scale(calc(1 + var(--p, 0) * 1.15));
          filter: blur(calc(var(--p, 0) * var(--p, 0) * 7px));
        }

        /* The two lines part, and the house withdraws through the gap. */
        html[data-wp="C"] .ph--greet {
          transform: translate(calc(var(--p, 0) * -4vw), calc(var(--p, 0) * -4vh));
        }

        html[data-wp="C"] .ph--name {
          transform: translate(calc(var(--p, 0) * 2.5vw), calc(var(--p, 0) * 4vh));
        }

        /* The house holds on longer, so the words are what passes you. */
        html[data-wp="C"] .hero.hero--anchored .hero__art {
          transform: translateX(calc(var(--art-x, 0px) * (1 - var(--p, 0))))
            translateY(calc(var(--p, 0) * -12vh)) scale(calc(1 - var(--p, 0) * 0.42));
        }
      }

      /* ---- D: motes ----------------------------------------------------- */
      .ph-motes {
        position: absolute;
        inset: 0;
        /* Above the illustration, below the words: the motes cross in front of
           the house on their way over. */
        z-index: 2;
        pointer-events: none;
        display: none;
        opacity: clamp(0, calc((0.5 - var(--p, 0)) / 0.5), 1);
      }

      html[data-wp="D"] .ph-motes {
        display: block;
      }

      /* ---- The switcher (prototype chrome, not the design) -------------- */
      .wp-bar {
        position: fixed;
        z-index: 999;
        left: 50%;
        /* Clear of Astro's own dev toolbar, which also sits bottom-centre. */
        bottom: 74px;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 5px 6px;
        border-radius: 999px;
        background: #171310;
        color: #f6efe4;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.34);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 12px;
      }

      .wp-bar__step {
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        padding: 0;
        border: 0;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        color: inherit;
        cursor: pointer;
      }

      .wp-bar__step:hover {
        background: rgba(255, 255, 255, 0.2);
      }

      .wp-bar__replay {
        margin-left: 6px;
        background: transparent;
        opacity: 0.55;
      }

      .wp-bar__label {
        display: flex;
        align-items: baseline;
        gap: 8px;
        padding: 0 10px;
        white-space: nowrap;
      }

      .wp-bar__key {
        font-weight: 700;
        color: #ffd254;
      }

      .wp-bar__name {
        opacity: 0.8;
      }
    </style>
  </>
)}
