---
/**
 * The Therapy floor: the hub every therapy page hangs off.
 *
 * It was /services/, and /services/ now forwards here (astro.config.mjs). The
 * lift has six floors and no drop-downs, so this page is how a visitor — and a
 * search engine — reaches each therapy page: one plain link per page, under
 * the heading of who it is for, generated from `src/content/services/` so a
 * new page is listed the moment its Markdown file exists.
 *
 * The fee table moved to /fees/ (issue #30), with the Medicare rebates and
 * everything else that changes what a session costs. This page keeps a short
 * pointer where the table used to be, so a visitor who came here for prices
 * is one link away from them.
 */
import { withBase } from '../../lib/base.js';
import { inlineHtml } from '../../lib/inline-text.js';
import { getCollection, getEntry, render } from 'astro:content';
import PlainLayout from '../../layouts/PlainLayout.astro';
import HeroReveal from '../../components/HeroReveal.astro';
import ServiceList from '../../components/ServiceList.astro';
import Vignette from '../../components/Vignette.astro';
import { hubGroups, hubLinks } from '../../lib/services.js';
import { includeInBuild, isProductionSite } from '../../lib/drafts.js';

const production = isProductionSite(Astro.site);
const built = await getCollection('services', (entry) => includeInBuild(entry.data, production));
const groups = hubGroups(built);
/* The audience hubs (/adults/, /children/) gather therapy and assessments for
   one age group; linked here for the visitor who starts from who, not what. */
const audienceHubs = hubLinks(built);

const page = await getEntry('pages', 'services');
if (!page) throw new Error('Missing content: src/content/pages/services.md');

const { Content } = await render(page);
const { title, documentTitle, description, lede, offerings, therapyModels, therapyHubText: text } = page.data;
if (!text) throw new Error('Missing therapyHubText in src/content/pages/services.md');

/* The group headings are edited with the page; the keys are HUB_GROUPS'. */
const groupHeadings: Record<string, string> = {
  adults: text.groupHeadings.adults,
  'children-families': text.groupHeadings.childrenFamilies,
  couples: text.groupHeadings.couples,
  'how-we-work': text.groupHeadings.howWeWork,
  more: text.groupHeadings.more,
};
---

<PlainLayout title={title} documentTitle={documentTitle} description={description}>
  <HeroReveal
    room="services"
    roomName="the consulting room"
    slot="hero"
    title={title}
    lede={lede}
    image={withBase("/assets/rooms/consulting-room-out.webp")}
    imageSmall={withBase("/assets/rooms/consulting-room-out-720.webp")}
    imageMedium={withBase("/assets/rooms/consulting-room-out-1080.webp")}
    imageMediumWidth={1086}
    imageAlt="The consulting room — armchairs, lamplight and a window onto the garden"
    imageWidth={1448}
    imageHeight={1086}
  />

  <div class="wrap page">
    {/* The words, and beside them the room they describe: two armchairs and a
        lamp, so the page never has to say the place is warm. */}
    <div class="intro">
      <div class="prose--flush prose stack">
        <Content />
      </div>
      <Vignette class="intro__art" name="therapy-intro" sizes="(min-width: 58rem) 300px, 220px" />
    </div>

    {audienceHubs.length > 0 && (
      <section class="hub" aria-labelledby="by-age">
        <h2 id="by-age">{text.audienceHeading}</h2>
        <ServiceList links={audienceHubs} />
      </section>
    )}

    {groups.length > 0 && (
      <section class="hub" aria-labelledby="therapy-pages">
        <h2 id="therapy-pages">{text.groupsHeading}</h2>
        {/* A group of one page takes half a row, so two of them share one
            instead of each leaving an empty half beside it. */}
        <div class="hub__groups">
          {groups.map((group) => (
            <section
              class:list={['hub__group', group.links.length === 1 && 'hub__group--single']}
              aria-labelledby={`hub-${group.key}`}
            >
              <h3 id={`hub-${group.key}`}>{groupHeadings[group.key] ?? group.label}</h3>
              <ServiceList links={group.links} />
            </section>
          ))}
        </div>
      </section>
    )}

    {/*
      What the clinic does, in one band: the list a visitor scans for their own
      situation, and the methods behind it beside rather than under. Stacked,
      they were two identically-set bullet lists a screen apart with nothing to
      tell a parent which one was for them.
    */}
    <div class="band">
      <section aria-labelledby="offerings">
        <h2 id="offerings">{text.offeringsHeading}</h2>
        <ul class="tick-list">
          {offerings?.map((item) => <li>{item}</li>)}
        </ul>
        <p class="band__aside-note" set:html={inlineHtml(text.assessmentsNote)} />
      </section>

      <section class="band__side" aria-labelledby="models">
        <h2 id="models">{text.modelsHeading}</h2>
        <ul class="tick-list band__side-list">
          {therapyModels?.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </div>

    {/* Two short answers that send you somewhere else, side by side as a pair
        of signposts, each with the object it points to. */}
    <div class="pointers">
      <section class="pointer" aria-labelledby="fees">
        <Vignette class="pointer__art" name="fees" sizes="120px" />
        <div>
          <h2 id="fees">{text.feesHeading}</h2>
          <p set:html={inlineHtml(text.feesText)} />
          <p>
            <a class="standalone-link" href={withBase('/fees/')}>{text.feesLinkText}</a>
          </p>
        </div>
      </section>

      <section class="pointer" aria-labelledby="video">
        <Vignette class="pointer__art" name="video" sizes="120px" />
        <div>
          <h2 id="video">{text.videoHeading}</h2>
          <p set:html={inlineHtml(text.videoText)} />
          <p>
            <a class="standalone-link" href={withBase('/telehealth/')}>{text.videoLinkText}</a>
          </p>
        </div>
      </section>
    </div>
  </div>
</PlainLayout>

<style>
  /* Three questions on one page: what you can come here for, how the work is
     done, what it costs. The break between two questions is the page's largest
     interval; inside one, the heading's own margin is the whole gap. Every
     section used to open on the same 64px, which gave three headings identical
     weight and the page no cadence. */
  .page > * + * {
    margin-top: var(--space-section);
  }

  .page h2 {
    margin-top: 0;
  }

  /* ---- The hub ----
     Each heading sits a section-sized step below the last, but a heading and
     its own list stay together: the list is the answer to the heading. */
  .hub__groups {
    display: grid;
    /* An explicit track: an implicit `auto` one sizes to the tile list's
       content, which lays two tiles side by side and pushes a phone sideways. */
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-2xl);
    max-width: 68rem;
  }

  .hub__group h3 {
    margin-top: 0;
  }

  /* The same two columns the tiles use, so a single tile in a half-row lines
     up with the tiles in the full rows above it. */
  @media (min-width: 55rem) {
    .hub__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-lg);
    }

    .hub__group {
      grid-column: 1 / -1;
    }

    .hub__group--single {
      grid-column: auto;
    }
  }

  /* ---- The two-column band ----
     What the clinic helps with, beside the methods behind it. */
  .band {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .band {
      grid-template-columns: minmax(0, var(--content-max)) minmax(15rem, 1fr);
      column-gap: clamp(var(--space-2xl), 4.5vw, 5rem);
    }

    /* "What we help with" is set at h2 and "How we work" a step below it, which
       is the hierarchy this band is for. Aligned on the tops of their boxes,
       though, two different sizes start on two different lines and the
       deliberate step reads as a misalignment — seven pixels of it, which is
       exactly the amount that looks like a mistake rather than a decision.
       Baseline alignment puts both headings on one line and lets the size
       difference be the only thing saying which one leads. */
    .band {
      align-items: baseline;
    }
  }

  /* Supporting, and sized to say so. The methods are what
     a visitor reads after they have found their own situation in the column
     beside them, not before. */
  .band__side h2 {
    font-size: var(--text-subhead);
    line-height: var(--lh-subhead);
  }

  .band__side-list {
    margin-bottom: 0;
  }

  .band__aside-note {
    margin-bottom: 0;
  }

  /* ---- The intro and its picture ----
     The same arrangement as the home page's intro: the art to the right of the
     reading column on wide screens, under it on a phone. */
  .intro {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .intro :global(.intro__art) {
    display: block;
    width: min(220px, 60%);
    height: auto;
    justify-self: center;
  }

  @media (min-width: 58rem) {
    .intro {
      grid-template-columns: minmax(0, var(--content-max)) minmax(0, 300px);
      column-gap: clamp(var(--space-2xl), 5vw, 88px);
    }

    .intro :global(.intro__art) {
      width: 100%;
    }
  }

  /* ---- The group headings ----
     A rule running on from each audience's name, so four groups of tiles read
     as four shelves rather than one long run of them. */
  .hub__group h3 {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    max-width: 68rem;
  }

  .hub__group h3::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  /* ---- The two signposts ---- */
  .pointers {
    display: grid;
    gap: var(--space-xl);
    max-width: 68rem;
  }

  @media (min-width: 52rem) {
    .pointers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pointer {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
    padding: var(--space-xl);
    background: var(--surface-sunk);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-xl);
    box-shadow: var(--edge-lit);
  }

  .pointer :global(.pointer__art) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 10px rgba(48, 25, 8, 0.14));
  }

  /* Supporting answers, so a step below the page's main headings. */
  .pointer h2 {
    font-size: var(--text-subhead);
    line-height: var(--lh-subhead);
    margin-bottom: var(--space-sm);
  }

  .pointer p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 30rem) {
    .pointer {
      grid-template-columns: 1fr;
      padding: var(--space-lg);
    }

    .pointer :global(.pointer__art) {
      width: 5.5rem;
    }
  }
</style>
