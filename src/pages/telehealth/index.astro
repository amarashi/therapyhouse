---
/**
 * The Telehealth Room (issue #25, R-56): video sessions anywhere in Australia.
 *
 * Prose lives in src/content/pages/telehealth.md. Medicare amounts come from
 * src/data/medicare.js, the same data /fees/ reads, so the two pages can never
 * disagree. Regional towns come from src/content/towns/: a town with three
 * sourced facts has its own page and is linked here; the rest are short
 * sections on this page (R-59).
 */
import { getCollection, getEntry, render } from 'astro:content';
import PlainLayout from '../../layouts/PlainLayout.astro';
import PersonCard from '../../components/PersonCard.astro';
import IllustratedHead from '../../components/IllustratedHead.astro';
import Vignette from '../../components/Vignette.astro';
import art from '../../data/service-art.json';
import { withBase } from '../../lib/base.js';
import { inlineHtml } from '../../lib/inline-text.js';
import { builtPaths } from '../../lib/links.js';
import { businessId } from '../../lib/services.js';
import { includeInBuild, isProductionSite } from '../../lib/drafts.js';
import { splitTowns, townPath } from '../../lib/towns.js';
import { callsToAction, site } from '../../data/site.js';
import { assertRebatesCurrent, formatAsAt, formatRebate, itemUrl, medicare } from '../../data/medicare.js';

assertRebatesCurrent(medicare);

const production = isProductionSite(Astro.site);
const services = await getCollection('services', (entry) => includeInBuild(entry.data, production));
const built = builtPaths(Object.keys(import.meta.glob('/src/pages/**/*.astro')), services);
const linkIfBuilt = (path: string) => (built.has(path) ? withBase(path) : null);

const page = await getEntry('pages', 'telehealth');
if (!page) throw new Error('Missing content: src/content/pages/telehealth.md');
const { Content } = await render(page);
const { title, documentTitle, description, lede, process, telehealthText: text } = page.data;
if (!text) throw new Error('Missing telehealthText in src/content/pages/telehealth.md');

const towns = splitTowns(
  await getCollection('towns', (entry) => includeInBuild(entry.data, production))
);
const townSections = await Promise.all(
  towns.sections.map(async (entry) => ({ entry, Body: (await render(entry)).Content }))
);

const practitioners = (await getCollection('team', (entry) => includeInBuild(entry.data, production)))
  .filter((p) => p.data.kind === 'practitioner')
  .sort((a, b) => a.data.order - b.data.order);

const forWhom = [
  { label: 'Adults', href: linkIfBuilt('/adults/') },
  { label: 'Children and teenagers', href: linkIfBuilt('/children/') },
  { label: 'Couples', href: linkIfBuilt('/therapy/couples/') },
].filter((link) => link.href);

const asAt = formatAsAt(medicare.asAt);

const url = new URL(Astro.url.pathname, Astro.site ?? site.origin).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Telehealth psychology',
  description,
  url,
  serviceType: 'Telehealth psychology',
  provider: { '@id': businessId(site.origin) },
  areaServed: { '@type': 'Country', name: 'Australia' },
  availableChannel: {
    '@type': 'ServiceChannel',
    name: 'Video session',
    serviceUrl: callsToAction.book.href,
  },
};
---

<PlainLayout title={title} documentTitle={documentTitle} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <div class="wrap page telehealth">
    <IllustratedHead title={title} lede={lede} art="video" />

    <div class="prose--flush prose prose--chapters stack">
      <Content />
      {forWhom.length > 0 && (
        <p>
          {text.moreHelpIntro}{' '}
          {forWhom.map((link, i) => (
            <>{i > 0 && ', '}<a href={link.href}>{link.label.toLowerCase()}</a></>
          ))}.
        </p>
      )}
    </div>

    {/* What it costs, as two boxes side by side: what Medicare pays back, and
        where the fees are. Each with the object it is about. */}
    <div class="money">
    <section class="money__box" aria-labelledby="medicare">
      <Vignette class="money__art" name="medicare" sizes="104px" />
      <h2 id="medicare">{text.medicareHeading}</h2>
      <div class="prose--flush prose stack">
        <p>
          Medicare pays the same rebate for a video session as for a session in the room. With a
          referral and a Mental Health Treatment Plan from your GP, Medicare pays back part of the
          fee for up to {medicare.sessionsPerYear} individual sessions a calendar year.
        </p>
        <ul class="tick-list">
          {medicare.rebates.map((row) => (
            <li>
              {row.label}: {formatRebate(row.rebate)} a session (MBS item{' '}
              <a href={itemUrl(row.items.video)}>{row.items.video}</a>)
            </li>
          ))}
        </ul>
        <p class="telehealth__source">
          Rebates for a video session of at least 50 minutes, as at {asAt}, from{' '}
          <a href={medicare.source}>{medicare.sourceName}</a>.
        </p>
        <p>
          <a class="standalone-link" href={withBase('/fees/#referral')}>{text.referralLinkText}</a>
        </p>
      </div>
    </section>

    <section class="money__box" aria-labelledby="fees">
      <Vignette class="money__art" name="fees" sizes="104px" />
      <h2 id="fees">{text.feesHeading}</h2>
      <p set:html={inlineHtml(text.feesText)} />
      <p>
        <a class="standalone-link" href={withBase('/fees/')}>{text.feesLinkText}</a>
      </p>
    </section>
    </div>

    {process && process.length > 0 && (
      <section aria-labelledby="first-session">
        <h2 id="first-session">{text.processHeading}</h2>
        <div class="first-session">
          <ol class="step-list">
            {process.map((step) => <li>{step}</li>)}
          </ol>
          {/* The quiet corner the first step asks for. */}
          <Vignette class="first-session__art" name="telehealth-setup" sizes="220px" />
        </div>
      </section>
    )}

    {townSections.length > 0 && (
      <section aria-labelledby="regional">
        <h2 id="regional">{text.regionalHeading}</h2>
        <p set:html={inlineHtml(text.regionalText)} />
        {/* A card for each town, its picture on top: the cane and palms of
            Mackay, the harbour at Gladstone, the red earth of Mount Isa. */}
        <div class="towns">
        {townSections.map(({ entry, Body }) => (
          <section class="town" aria-labelledby={`town-${entry.id}`}>
            {entry.id in art && <Vignette class="town__art" name={entry.id} sizes="200px" />}
            <h3 id={`town-${entry.id}`}>{entry.data.name}</h3>
            <div class="prose--flush prose stack">
              <Body />
            </div>
            <p class="telehealth__source">
              Source{entry.data.facts.length > 1 ? 's' : ''}:{' '}
              {entry.data.facts.map((fact, i) => (
                <>{i > 0 && '; '}<a href={fact.sourceUrl}>{fact.sourceName}</a></>
              ))}
            </p>
          </section>
        ))}
        </div>
      </section>
    )}

    {towns.pages.length > 0 && (
      <nav aria-labelledby="town-pages">
        <h2 id="town-pages">{text.townPagesHeading}</h2>
        <ul class="telehealth__towns">
          {towns.pages.map((entry) => (
            <li>
              <a class="standalone-link" href={withBase(townPath(entry.id))}>{entry.data.h1}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <section aria-labelledby="who">
      <h2 id="who">{text.cliniciansHeading}</h2>
      <p set:html={inlineHtml(text.cliniciansText)} />
      <ul class="people">
        {practitioners.map((person) => (
          <li><PersonCard person={person} /></li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="booking">
      <h2 id="booking">{text.bookingHeading}</h2>
      <p set:html={inlineHtml(text.bookingText)} />
    </section>
  </div>
</PlainLayout>

<style>
  .page > * + * {
    margin-top: var(--space-section);
  }

  .page h2 {
    margin-top: 0;
  }

  .telehealth__source {
    font-size: var(--text-secondary);
  }

  /* ---- Medicare and fees ---- */

  .money {
    display: grid;
    gap: var(--space-2xl) var(--space-xl);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .money {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }

  .money__box {
    position: relative;
    padding: var(--space-2xl) var(--space-xl) var(--space-xl);
    background: var(--surface-sunk);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-lg);
    box-shadow: var(--edge-lit);
  }

  .money__box :global(.money__art) {
    position: absolute;
    top: 0;
    right: var(--space-xl);
    width: 6rem;
    height: auto;
    transform: translateY(-55%);
    filter: drop-shadow(0 8px 10px rgba(48, 25, 8, 0.16));
    pointer-events: none;
  }

  .money__box h2 {
    padding-right: 6.5rem;
    font-size: var(--text-subhead);
    line-height: var(--lh-subhead);
  }

  .money__box > :last-child,
  .money__box .stack > :last-child {
    margin-bottom: 0;
  }

  /* ---- The first session ---- */

  .first-session {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .first-session .step-list {
    margin-bottom: 0;
    max-width: var(--content-max);
  }

  .first-session :global(.first-session__art) {
    display: block;
    width: min(200px, 60%);
    height: auto;
  }

  @media (min-width: 60rem) {
    .first-session {
      grid-template-columns: minmax(0, var(--content-max)) 220px;
      column-gap: var(--space-3xl);
    }

    .first-session :global(.first-session__art) {
      width: 100%;
    }
  }

  /* ---- Regional towns ---- */

  .towns {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
  }

  .town {
    padding: var(--space-lg) var(--space-xl) var(--space-xl);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--edge-lit);
  }

  .town :global(.town__art) {
    display: block;
    width: 160px;
    height: auto;
    margin: 0 auto var(--space-sm);
    filter: drop-shadow(0 8px 10px rgba(48, 25, 8, 0.14));
  }

  .town h3 {
    margin-top: 0;
  }

  .town .telehealth__source {
    margin-bottom: 0;
  }

  .telehealth__towns {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-xl);
  }

  .people {
    list-style: none;
    padding: 0;
    margin: var(--space-xl) 0 0;
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(min(26rem, 100%), 1fr));
  }

  .people > li {
    container-type: inline-size;
    display: grid;
  }
</style>
