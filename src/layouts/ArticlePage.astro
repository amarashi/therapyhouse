---
/**
 * One layout for every library article: a plain reading page on PlainLayout.
 *
 * The body is the article as the clinic published it. Everything this layout
 * adds is around it, never inside it: the date, who wrote it, a crisis line
 * where the topic calls for one, and a way back to the library.
 *
 * Plain reading pages ship no JavaScript, and this adds none.
 */
import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PlainLayout from './PlainLayout.astro';
import { withBase } from '../lib/base.js';
import { site } from '../data/site.js';
import { articleDocumentTitle, articleSchema } from '../lib/articles.js';
import { missingIds } from '../lib/services.js';

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const data = entry.data;

/* An author slug that matches nobody is a build error, not a missing name. */
if (data.author) {
  const teamIds = (await getCollection('team')).map((p) => p.id);
  const unknown = missingIds([data.author.id], teamIds);
  if (unknown.length) {
    throw new Error(`Article "${entry.id}" names an author who is not in the team: ${unknown[0]}`);
  }
}
const author = data.author ? await getEntry(data.author) : undefined;
const authorHref = author ? withBase(`/team/${author.id}/`) : undefined;

const { Content } = await render(entry);

const pageOrigin = Astro.site ?? site.origin;
const url = new URL(Astro.url.pathname, pageOrigin).href;
const imageUrl = data.image ? new URL(withBase(data.image), pageOrigin).href : undefined;
const schema = articleSchema(data, {
  url,
  origin: site.origin,
  imageUrl,
  author: author && authorHref
    ? { name: author.data.name, url: new URL(authorHref, pageOrigin).href }
    : undefined,
});

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(date);
---

<PlainLayout
  title={data.title}
  documentTitle={articleDocumentTitle(entry.id, data, site.name)}
  description={data.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <article class="wrap article">
    <header class="article__head">
      {data.draft && (
        <p class="article__draft">Draft for review. This article is not on the clinic's website.</p>
      )}
      <p class="article__kicker">
        <a href={withBase('/library/')}>Library</a> · {data.category}
      </p>
      <h1>{data.title}</h1>
      <p class="article__meta">
        Published <time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}</time>
        {author && authorHref && (
          <> · <a href={authorHref}>{author.data.name}</a>, {author.data.role}</>
        )}
      </p>
    </header>

    {data.image && (
      <img
        class="article__image"
        src={withBase(data.image)}
        alt={data.imageAlt ?? ''}
        loading="eager"
        decoding="async"
      />
    )}

    <div class="prose prose--flush article__body">
      <Content />
    </div>

    {data.crisisNote && (
      <aside class="article__crisis" aria-label="If you need help now">
        <p>
          If you need to talk to someone now, call Lifeline on <a href="tel:131114">13 11 14</a>
          (any time, day or night). In an emergency, call <a href="tel:000">000</a>.
        </p>
      </aside>
    )}

    <p class="article__note">
      General information, not personal advice. If something here sounds like your situation,
      talk to your GP or <a href={withBase('/contact/')}>get in touch with us</a>.
    </p>

    <p><a class="standalone-link" href={withBase('/library/')}>Back to the library</a></p>
  </article>
</PlainLayout>

<style>
  .article {
    padding-top: var(--space-2xl);
  }

  .article > * {
    max-width: var(--content-max);
  }

  .article__head h1 {
    margin-top: var(--space-xs);
    text-wrap: balance;
  }

  .article__kicker,
  .article__meta {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--text-meta);
  }

  .article__meta {
    margin-bottom: var(--space-xl);
  }

  /* Loud on purpose: a reviewer must never mistake a draft for the real page. */
  .article__draft {
    display: inline-block;
    background: var(--surface-sunk);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-secondary);
    font-weight: 700;
    color: var(--heading);
  }

  .article__image {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-xl);
  }

  /* Headshots and figures inside the article: never wider than the column,
     and never taller than a phone screen. */
  .article__body :global(img) {
    max-height: 20rem;
    width: auto;
    border-radius: var(--radius-sm);
  }

  .article__crisis {
    margin-top: var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-sunk);
  }

  .article__crisis p {
    margin: 0;
  }

  .article__note {
    margin-top: var(--space-xl);
    color: var(--ink-soft);
    font-size: var(--text-secondary);
  }
</style>
