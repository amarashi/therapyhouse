---
import { withBase, basePrefix } from '../lib/base.js';
import { getCollection, getEntry } from 'astro:content';
import { site, contact, businessFacts, callsToAction } from '../data/site.js';
import { includeInBuild, isProductionSite, shownItems } from '../lib/drafts.js';
import { businessSchema as buildBusinessSchema } from '../lib/structured-data.js';
import { assertRebatesCurrent, medicare } from '../data/medicare.js';
import { HOUSE_CONTENT_ID, houseContent, houseContentJson } from '../lib/house-content.js';
import { teamPortrait } from '../lib/team-portraits.js';
import { books, videos } from '../data/library-shelf.js';
import { clinic, phoneHref, roomNavigation, siteContent } from '../../public/assets/scripts/content-data.js';
import houseCopy from '../../public/assets/content/house-copy.json';
import houseRooms from '../../public/assets/content/house-rooms.json';
import Analytics from '../components/Analytics.astro';
import DebugPanel from '../house-debug/DebugPanel.astro';

/*
 * The legacy single-page experience, preserved intact through the migration.
 * Its scripts live in `public/assets/scripts/` and are served as-is, so they
 * cannot read Astro's config the way a bundled module can. Instead they read
 * `window.__ASSET_BASE__`, set in the head below, and prefix their own asset
 * paths with it — see the note at the top of `site-data.js`.
 *
 * The trailing slash matters: those paths are relative (`assets/…`), so the
 * base has to be a directory.
 */
const assetBase = `${basePrefix}/`;
// Same preview guard as PlainLayout.astro: the GitHub Pages build must not
// be indexed as a second copy of the clinic's site.
const isPreview = (Astro.site?.hostname ?? '').endsWith('github.io');
const production = isProductionSite(Astro.site);

/* The same clinic record as every reading page (src/lib/structured-data.js),
   rather than a hand-written copy that drifts from it. */
const businessSchema = buildBusinessSchema({
  site,
  contact,
  facts: businessFacts,
  services: await getCollection('services', (entry) =>
    entry.data.kind !== 'hub' && includeInBuild(entry.data, production)
  ),
  siteUrl: Astro.site ?? site.origin,
  pageBase: withBase,
});
/* One address for the house. The heroes link here with `?from=` and
   `?room=` so the visit starts in the right room and the exit leads back,
   but those are the same page: the canonical is always the bare `/house/`,
   built from the pathname so a query string can never leak into it. */
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/* Everything a visitor reads in the rooms, built from the same files the
   plain pages read (docs/house-plan.md, phase A): the pages, the team, the
   services, the articles, the clinic's details and the library shelf. Only
   what this build shows goes in ("Show on the live website", issue #95), so
   a person, package or program switched off is not in the house either, and
   a sign whose preview is missing is left off its room by `content-data.js`.
   See src/lib/house-content.js. */
assertRebatesCurrent(medicare);
const pageIds = ['services', 'fees', 'assessments', 'group-therapy', 'library', 'philosophy', 'work-with-us', 'contact', 'telehealth'];
const pages = Object.fromEntries(
  await Promise.all(
    pageIds.map(async (id) => {
      const entry = await getEntry('pages', id);
      if (!entry) throw new Error(`Missing content: src/content/pages/${id}.md`);
      const data = { ...entry.data };
      for (const list of ['fees', 'packages', 'programs']) {
        if (data[list]) data[list] = shownItems(data[list], production);
      }
      return [id, data];
    })
  )
);
const shown = (entry) => includeInBuild(entry.data, production);
const content = houseContent({
  pages,
  services: await getCollection('services', shown),
  articles: await getCollection('articles', shown),
  team: await getCollection('team', shown),
  towns: await getCollection('towns', shown),
  books,
  videos,
  clinic,
  links: houseCopy.links,
  medicare,
  href: withBase,
  portrait: (image) => withBase(teamPortrait(image).photo ?? image),
});
const contentJson = houseContentJson(content);
const philosophy = pages.philosophy;
/* A sign's own words, for the pop-up it opens (house-rooms.json). */
const signLabel = (roomId, signId) =>
  houseRooms.rooms.find((room) => room.id === roomId)?.signs.find((sign) => sign.id === signId)?.label ?? '';
/* The rooms menu: every room the house has, in the order the house lists
   them, with the exterior named as the way outside. */
/* For screen readers, and for anyone whose browser runs no script: every
   room and the plain page it stands for. The room records carry the page as
   a path relative to the site root ("therapy/"); the welcome room's is "". */
const roomPages = roomNavigation.roomOrder
  .filter((id) => id !== 'exterior' && siteContent.rooms[id]?.sourceUrls?.length)
  .map((id) => ({ name: roomNavigation.rooms[id].title, href: withBase(`/${siteContent.rooms[id].sourceUrls[0]}`) }));
const menuRooms = roomNavigation.roomOrder.map((id) => ({
  id,
  name: id === 'exterior' ? houseCopy.menu.outside : roomNavigation.rooms[id].title,
}));
const contactPreview = {
  phone: contact.phone,
  tel: phoneHref(contact.phone),
  email: contact.email,
  address: contact.address,
  map: content.previews['contact.address'].link.href,
  booking: contact.bookingUrl,
};
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {isPreview && <meta name="robots" content="noindex, nofollow">}
  <meta name="description" content="Walk through Therapy House in The Gap, Brisbane: an illustrated tour of the clinic's rooms, its team, its services and how to book.">
  <meta name="theme-color" content="#ffffff">
  <meta property="og:title" content="Explore the House | Therapy House, The Gap, Brisbane">
  <meta property="og:description" content="Walk through Therapy House in The Gap, Brisbane: an illustrated tour of the clinic's rooms, its team, its services and how to book.">
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <link rel="canonical" href={canonical}>
  <meta property="og:image" content={new URL(withBase("/assets/media/logo3d.png"), Astro.site ?? "https://www.therapyhouse.com.au").href}>
  <link rel="icon" type="image/png" href={withBase("/assets/media/favicon-64.png")} sizes="64x64">
  <link rel="icon" href={withBase("/favicon.ico")} sizes="16x16 32x32 48x48">
  <script is:inline define:vars={{ assetBase }}>window.__ASSET_BASE__ = assetBase;</script>
  <script is:inline type="application/json" id={HOUSE_CONTENT_ID} set:html={contentJson}></script>
  <title>Explore the House | Therapy House, The Gap, Brisbane</title>
  <link rel="stylesheet" href={withBase("/assets/styles/main.css?v=20261013-text")}>
  <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  <Analytics />
</head>
<body>
  <a class="skip-link" href="#siteOverview">{houseCopy.page.skip}</a>
  {/* The house is a full screen with none of the site's chrome on it, and the
      rooms are now reachable straight from the reading pages — so there has to
      be a plain way back to the one you left. `app.js` points this at the
      `?from` path when there is one, and at the front page when there is not. */}
  <a class="house-exit" id="houseExit" href={withBase("/")}>
    <svg class="house-exit__mark" width="15" height="14" viewBox="0 0 15 14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M13.75 7H2.4"></path>
      <path d="M6.6 2.1 1.7 7l4.9 4.9"></path>
    </svg>
    <span>{houseCopy.page.exit}</span>
  </a>
  {/* Any room, from anywhere in the house, without walking back outside to
      find its door (docs/house-plan.md, phase C). `app.js` moves the visit
      and marks the room you are in. */}
  <nav class="room-menu" id="roomMenu" aria-label={houseCopy.menu.heading}>
    <button class="room-menu__toggle" id="roomMenuToggle" type="button" aria-expanded="false" aria-controls="roomMenuList">
      <svg class="room-menu__mark" width="16" height="14" viewBox="0 0 16 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M1.5 6.5 8 1.5l6.5 5"></path>
        <path d="M3.2 5.4v7.1h9.6V5.4"></path>
        <path d="M6.6 12.5V9h2.8v3.5"></path>
      </svg>
      <span>{houseCopy.menu.button}</span>
    </button>
    <div class="room-menu__panel" id="roomMenuList" hidden>
      <p class="room-menu__heading">{houseCopy.menu.heading}</p>
      <ul class="room-menu__list">
        {menuRooms.map((room) => (
          <li><button class="room-menu__room" type="button" data-room={room.id}>{room.name}</button></li>
        ))}
      </ul>
    </div>
  </nav>
  <aside class="orientation-lock" aria-live="polite">
    <div class="orientation-lock__content">
      <div class="orientation-lock__logo-frame" aria-hidden="true">
        <img class="orientation-lock__logo" src={withBase("/assets/media/logo3d.png")} alt="Therapy House logo" draggable="false" loading="lazy" decoding="async">
      </div>
      <span class="orientation-lock__rotate-mark" aria-hidden="true"></span>
      <p class="orientation-lock__title">{houseCopy.page.rotateTitle}</p>
      <p class="orientation-lock__text">{houseCopy.page.rotateText}</p>
    </div>
  </aside>
  <main class="stage" id="stage" aria-labelledby="siteTitle" aria-describedby="siteSummary">
    <section class="sr-only" id="siteOverview" tabindex="-1">
      <h1 id="siteTitle">{houseCopy.page.title}</h1>
      <p id="siteSummary">{houseCopy.page.summary}</p>
      <h2>{houseCopy.page.roomsHeading}</h2>
      <ul>
        {roomPages.map((room) => (
          <li><a href={room.href}>{room.name}</a></li>
        ))}
      </ul>
    </section>
    <canvas id="viewerCanvas" aria-label="Interactive Therapy House exterior">{houseCopy.page.exterior}</canvas>
    <button class="door-hotspot" id="doorHotspot" type="button" aria-label="Open the Therapy House entrance">
      <span class="sparkle" aria-hidden="true"></span>
      <span class="sparkle" aria-hidden="true"></span>
      <span class="sparkle" aria-hidden="true"></span>
      <span class="sparkle" aria-hidden="true"></span>
    </button>
    <div class="exterior-hotspot-layer" id="exteriorHotspotLayer" aria-label="Therapy House exterior room navigation"></div>
    <video class="transition-video" id="doorVideo" playsinline preload="metadata">
      <source src={withBase("/assets/media/door-transition.mp4")} type="video/mp4">
    </video>
    <div class="inside-view" id="insideView" aria-label="Inside Therapy House">
      <div class="inside-parallax" id="insideParallax">
        {/* No `src` on these: the interior is hidden until the visitor walks in,
            so `inside-scene.js` loads the layers after first paint (or on entry,
            under Save-Data) rather than competing with the exterior. */}
        <img class="inside-parallax__layer inside-parallax__layer--background" data-src={withBase("/assets/media/inside-layer-1.webp")} alt="Layered illustration of the warm Therapy House clinic interior" draggable="false" decoding="async">
        <div class="inside-firelight-layer" id="insideFirelightLayer" aria-hidden="true"></div>
        <img class="inside-parallax__layer inside-parallax__layer--middle" data-src={withBase("/assets/media/inside-layer-2.webp")} alt="Middle layer of the Therapy House counselling room scene" draggable="false" decoding="async">
        <div class="dog-eye-layer" id="dogEyeLayer" aria-hidden="true"></div>
        <img class="inside-parallax__layer inside-parallax__layer--foreground" data-src={withBase("/assets/media/inside-layer-3.webp")} alt="Foreground layer of the welcoming Therapy House interior" draggable="false" decoding="async">
      </div>
      {/* The room's signs are drawn here by `inside-scene.js` from content-data.js
          and house-rooms.json, for whichever room is open. */}
      <div class="scene-sign-layer" id="sceneSignLayer" aria-hidden="false"></div>
      <div class="team-carousel" id="teamCarousel" role="dialog" aria-modal="true" aria-labelledby="teamCarouselTitle" aria-hidden="true" hidden>
        <div class="team-carousel__panel">
          <button class="team-carousel__close" id="teamCarouselClose" type="button" aria-label="Close team carousel">&times;</button>
          <h2 class="sr-only" id="teamCarouselTitle">{signLabel('team', 'team-carousel')}</h2>
          <div class="team-carousel__deck" id="teamCarouselDeck" aria-live="polite" aria-label="Swipe or use controls to browse team profiles"></div>
          <div class="team-carousel__nav">
            <span class="team-carousel__count" id="teamCarouselCount"></span>
            <div class="team-carousel__actions" aria-label="Team profile controls">
              <button class="team-carousel__button" id="teamCarouselPrev" type="button" aria-label="Show previous Therapy House team profile">&larr;</button>
              <button class="team-carousel__button" id="teamCarouselNext" type="button" aria-label="Show next Therapy House team profile">&rarr;</button>
            </div>
          </div>
        </div>
      </div>
      <div class="philosophy-modal" id="philosophyModal" role="dialog" aria-modal="true" aria-labelledby="philosophyTitle" aria-hidden="true" hidden>
        <section class="philosophy-modal__panel">
          <button class="philosophy-modal__close" id="philosophyModalClose" type="button" aria-label="Close philosophy window">&times;</button>
          <h2 class="philosophy-modal__title" id="philosophyTitle">{philosophy.title}</h2>
          <span class="content-modal__rule" aria-hidden="true"></span>
          <img class="philosophy-modal__image" src={withBase("/assets/media/bookworm.png")} width="600" height="450" loading="lazy" alt="Friendly reader with books, representing Therapy House's warm psychology and counselling approach">
          <p class="philosophy-modal__intro">{philosophy.lede}</p>
          <ul class="philosophy-modal__list">
            {(philosophy.principles ?? []).map((principle) => (
              <li class="philosophy-modal__item">
                <h3>{principle.title}</h3>
              </li>
            ))}
          </ul>
          {philosophy.closing && <p class="philosophy-modal__closing">{philosophy.closing}</p>}
          <a class="content-modal__more" href={withBase('/philosophy/')}>{houseCopy.links.philosophy}</a>
          <div class="house-actions" aria-label="Book or call">
            <a class="house-action" href={contactPreview.booking} target="_blank" rel="noopener">{callsToAction.book.label}</a>
            <a class="house-action" href={contactPreview.tel}>{callsToAction.call.label}</a>
          </div>
        </section>
      </div>
      <div class="content-modal" id="contentModal" role="dialog" aria-modal="true" aria-labelledby="contentModalTitle" aria-hidden="true" hidden>
        <section class="content-modal__panel">
          <button class="content-modal__close" id="contentModalClose" type="button" aria-label="Close content window">&times;</button>
          <p class="content-modal__eyebrow" id="contentModalEyebrow"></p>
          <h2 class="content-modal__title" id="contentModalTitle"></h2>
          <span class="content-modal__rule" aria-hidden="true"></span>
          <div class="content-modal__body" id="contentModalBody"></div>
          <div class="house-actions" id="contentModalActions" aria-label="Book or call">
            <a class="house-action" href={contactPreview.booking} target="_blank" rel="noopener">{callsToAction.book.label}</a>
            <a class="house-action" href={contactPreview.tel}>{callsToAction.call.label}</a>
          </div>
        </section>
      </div>
      <div class="contact-modal" id="contactModal" role="dialog" aria-modal="true" aria-labelledby="contactTitle" aria-hidden="true" hidden>
        <section class="contact-modal__panel">
          <button class="contact-modal__close" id="contactModalClose" type="button" aria-label="Close contact window">&times;</button>
          <div class="contact-modal__art">
            <img src={withBase("/assets/media/phone.webp")} alt="Illustration for contacting Therapy House reception" width="660" height="660" loading="lazy" decoding="async">
          </div>
          <div class="contact-modal__body">
            <h2 class="contact-modal__title" id="contactTitle">{signLabel('welcome', 'contact')}</h2>
            <p class="contact-modal__intro">{pages.contact.lede}</p>
            <div class="house-actions" aria-label="Book or call">
              <a class="house-action" href={contactPreview.booking} target="_blank" rel="noopener">{callsToAction.book.label}</a>
              <a class="house-action" href={contactPreview.tel}>{callsToAction.call.label}</a>
            </div>
            <dl class="contact-modal__details">
              <div class="contact-modal__detail">
                <dt>{houseCopy.page.phone}</dt>
                <dd><a href={contactPreview.tel}>{contactPreview.phone}</a></dd>
              </div>
              <div class="contact-modal__detail">
                <dt>{houseCopy.page.email}</dt>
                <dd><a href={`mailto:${contactPreview.email}`}>{contactPreview.email}</a></dd>
              </div>
              <div class="contact-modal__detail">
                <dt>{houseCopy.page.address}</dt>
                <dd><a href={contactPreview.map} target="_blank" rel="noopener">{contactPreview.address}</a></dd>
              </div>
            </dl>
            <a class="content-modal__more" href={withBase('/contact/')}>{houseCopy.links.contact}</a>
          </div>
        </section>
      </div>
      <div class="cursor-sparkle-layer" id="cursorSparkleLayer" aria-hidden="true"></div>
    </div>
  </main>

  {/* Development only: the tuning panel and its scripts never reach the build. */}
  {import.meta.env.DEV && <DebugPanel />}
  <script type="module" src={withBase("/assets/scripts/app.js?v=20261013-telehealth")}></script>
</body>
</html>

