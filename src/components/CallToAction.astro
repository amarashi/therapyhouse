---
import { withBase } from '../lib/base.js';
import { callsToAction } from '../data/site.js';

/**
 * The two calls to action, rendered side by side at equal weight.
 *
 * PRODUCT.md: booking online and calling reception carry *equal* weight —
 * some parents self-serve, others need to talk first, and neither path is the
 * fallback for the other. So the two are the same button: a filled Book beside
 * an outlined Call still read as "the action, and the fallback". The labels
 * tell them apart, and neither is ever rendered alone.
 */
const { book, call } = callsToAction;
---

{/* The portal is a different application. Opening it in place threw away a
    parent's place in whatever they were reading; a new tab keeps it. */}
<div class="cta">
  <a class="btn btn--primary" href={withBase(book.href)} target="_blank" rel="noopener noreferrer">
    {book.label}<span class="sr-only"> (opens in a new tab)</span>
  </a>
  <a class="btn btn--primary cta__call" href={withBase(call.href)}>{call.label}</a>
</div>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  /* A published number a parent is reading off the screen. */
  .cta__call {
    font-variant-numeric: lining-nums tabular-nums;
  }

  @media (max-width: 420px) {
    .cta {
      flex-direction: column;
    }

    .cta :global(.btn) {
      width: 100%;
    }
  }
</style>
